---
import BaseHead from "@components/ui/BaseHead.astro";
import Menu from "@components/ui/Menu.astro";
---

<html lang="en" data-theme="dark">
  <head>
    <BaseHead
      title="AG | Personal Projects"
      description="A collection of projects I've worked on, from frontend engineering to experiments with Three.js, WebGL and WebGPU."
      imageSrc="/og-images/projects.jpg"
    />
    <link
      rel="preload"
      href="/fonts/Berserker-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/utils/gradient-mask.webp"
      as="image"
      type="image/webp"
      crossorigin
    />
    <link
      rel="preload"
      href="/utils/god-of-war-mask.svg"
      as="image"
      type="image/svg+xml"
    />
    <script>
      import trackPointerMovement from "@components/scripts/trackPointerMovement";
      const cleanup = trackPointerMovement({
        rootSelector: ".gradient-mask",
        targets: ["figure"],
      });

      // If using Astro View Transitions (or any partial swap), clean up before swap
      document.addEventListener("astro:before-swap", () => cleanup?.());

      // On full-page unloads (and as a general safety net)
      window.addEventListener("pagehide", () => cleanup?.(), { once: true });

      // In dev, clean up on HMR dispose
      if (import.meta.hot) import.meta.hot.dispose(() => cleanup?.());
    </script>
    <style is:global>
      @font-face {
        font-family: "Berserker-Regular";
        src: url("/fonts/Berserker-Regular.woff2") format("woff2");
        font-display: swap;
      }
      html {
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
      }

      .wrapper {
        --text-accent: rgb(146, 41, 41);
        box-sizing: border-box;
        width: 100dvw;
      }

      .tagline {
        display: grid;
        grid-template-rows: 1fr 1fr;
        row-gap: 0.5em;
        margin: 0 auto 1em auto;
        max-width: min(80ch, 90dvw);
        font-family: "Berserker-Regular";
      }

      .tagline span.right-aligned {
        text-align: right;
      }

      .mask {
        position: relative;
      }

      .mask::after {
        position: absolute;
        content: "D";
        color: var(--text-accent);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        -webkit-mask-image: url(/utils/god-of-war-mask.svg);
        mask-image: url(/utils/god-of-war-mask.svg);
        mask-repeat: no-repeat;
        mask-position: 15%;
        mask-size: contain;
        filter: brightness(1.5);
      }

      .gallery {
        padding: 0;
        margin: 0;
        list-style-type: none;
      }

      .gallery .slide {
        position: relative;
        height: 100vh;
        scroll-snap-align: start;
        /* scroll-snap-stop: always; */
        box-sizing: border-box;
        view-timeline: --slide;
      }

      .gallery .slide .content {
        width: 100%;
        height: 100%;
        box-sizing: border-box;
      }

      .intro {
        display: grid;
        place-content: center;
      }

      /** https://grainy-gradients.vercel.app/noise.svg */
      .background {
        --mask-size: 800px;
        box-sizing: border-box;
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: url(/utils/god-of-war-mask.svg);
        background-repeat: no-repeat;
        background-position: 80% center;
        background-size: auto 150vh;
        opacity: 0.5;
        z-index: -1;
        font-family: "Berserker-Regular";

        --drop-shadow-opacity: 0.75;
        filter: contrast(1.02) brightness(0.99)
          drop-shadow(
            5px 5px 15px rgba(var(--text-raw), var(--drop-shadow-opacity))
          );
        display: flex;
        flex-direction: column;
        justify-content: end;
        align-items: center;
        padding: 2em;
        gap: 3em;
      }

      .background .tagline-two {
        max-width: 350px;
        width: 100%;
        display: flex;
        flex-direction: column;
        font-size: 1.15em;
      }

      .background .tagline-two span:last-of-type {
        text-align: right;
      }

      .background span.algiz {
        position: relative;
        display: block;
        width: 0;
        height: 0.85lh;
        border: 1.5px solid;
        color: red;
      }

      .background span.algiz::before {
        position: absolute;
        top: -10%;
        left: -50%;
        width: 1ch;
        aspect-ratio: 1/1;
        content: "";
        border-top: 3px solid;
        border-right: 3px solid;
        transform: translate(-50%, -10%) rotate(135deg);
      }

      .background span.algiz::after {
        position: absolute;
        top: 50%;
        left: -50%;
        width: 1.5lh;
        aspect-ratio: 1/1;
        content: "";
        transform: translate(-50%, -50%);
        border: 3px double;
        border-radius: 50%;
        opacity: 0.25;
      }

      .background::before {
        position: absolute;
        inset: 0;
        pointer-events: none;
        content: "";
        border: 2.5px solid red;
        pointer-events: none;
      }

      @supports (animation-timeline: scroll()) {
        @keyframes fade {
          0%,
          100% {
            opacity: 0;
            scale: 0.9;
          }
          50% {
            opacity: 1;
            scale: 1;
          }
        }

        .gallery .slide .content {
          animation-name: fade;
          animation-timing-function: ease-in-out;
          animation-direction: both;
          animation-timeline: --slide;
        }
      }

      @media screen and (max-width: 480px) {
        .tagline {
          font-size: 1.8em;
        }

        .background {
          background-position: 20vw center;
        }
      }

      @media (pointer: coarse) {
        .background {
          --mask-size: 75%;
          --x: 50%;
          --y: 0%;
        }
      }

      :root[data-theme="dark"] {
        .background {
          --drop-shadow-opacity: 0;
        }
      }
    </style>
  </head>
  <body>
    <Menu />
    <main class="wrapper">
      <ul class="gallery">
        <li class="slide">
          <div class="content intro">
            <div class="background gradient-mask force-gpu" aria-hidden="true">
              <div class="tagline-two">
                <span>In which direction?</span>
                <span>In the direction of the deer.</span>
              </div>
              <span class="algiz"></span>
            </div>
            <h1 class="tagline">
              <span>What are we hunting?</span>
              <span class="right-aligned"
                ><span class="mask" aria-hidden="true">D</span>eer.</span
              >
            </h1>
          </div>
        </li>
        <slot />
      </ul>
    </main>
  </body>
</html>
