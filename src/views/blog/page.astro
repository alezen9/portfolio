---
import { getCollection } from "astro:content";
import Layout from "./layout.astro";
import FormattedDate from "@components/ui/FormattedDate.astro";
import type { BlogPost } from "../../content.config";
import type { CollectionEntry } from "astro:content";

type RawPost = CollectionEntry<"blog">;

const isProd = import.meta.env.PROD;

const filterProd = (post: RawPost) => post.data.state === "Release";
const filterDev = (post: RawPost) =>
  ["Release", "Draft", "Example"].includes(post.data.state);

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter(isProd ? filterProd : filterDev);
---

<style>
  ul {
    list-style-type: none;
    padding-inline-start: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }

  li {
    cursor: pointer;
    width: fit-content;
  }

  a {
    all: unset;
  }

  .title {
    font-size: 1.15em;
    font-weight: bolder;
    color: color-mix(in oklab, var(--text-accent) 65%, var(--text-color));
  }

  .subtitle {
    margin-top: 0;
    font-size: 0.9em;
    font-weight: 400;
    max-width: 60ch;
  }

  .date {
    font-size: 0.75em;
    opacity: 0.75;
  }
</style>

<Layout>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <h2 class="title">{post.data.title}</h2>
            <h3 class="subtitle">{post.data.subtitle}</h3>
            <p class="date">
              <FormattedDate date={post.data.pubDate} />
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
