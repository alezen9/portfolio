---
import BaseHead from "@components/ui/BaseHead.astro";
import Menu from "@components/ui/Menu.astro";
---

<html lang="en" data-theme="dark">
  <head>
    <BaseHead title="AG | Blog detail" description="..." />
    <style>
      .wrapper {
        --text-accent: rgb(45, 114, 98);
        box-sizing: border-box;
        width: 100%;
        max-width: min(80ch, 90dvw);
        min-height: 100dvh;
        margin: 0 auto;
        padding: 2em;
        display: flex;
        flex-direction: column;
        gap: 4em;
      }
    </style>
  </head>
  <body>
    <Menu />
    <main class="wrapper">
      <slot />
    </main>
  </body>
</html>
