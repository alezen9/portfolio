---
import BaseHead from "@components/ui/BaseHead.astro";
import Menu from "@components/ui/Menu.astro";
import BlogHead from "./BlogHead.astro";
---

<html lang="en" data-theme="dark">
  <head>
    <BaseHead title="AG | Blog" description="..." />
    <BlogHead />
    <style is:global>
      .wrapper {
        box-sizing: border-box;
        width: 100%;
        max-width: min(80ch, 90dvw);
        min-height: 100dvh;
        margin: 0 auto;
        padding: 5.5em 2em 2em 2em;
        display: flex;
        flex-direction: column;
        gap: 4em;
      }

      .tagline {
        font-size: clamp(1.75rem, 6vw, 4.5rem);
        font-family: "Okashi-Regular";
      }
    </style>
  </head>
  <body>
    <Menu />
    <main class="wrapper">
      <h1 class="tagline">Chie no Mori</h1>
      <slot />
    </main>
  </body>
</html>
