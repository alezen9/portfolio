---
import BaseHead from "@components/ui/BaseHead.astro";
import Menu from "@components/ui/Menu.astro";
import BlogHead from "./BlogHead.astro";
import Bamboo from "./Bamboo.astro";
---

<html lang="en" data-theme="dark">
  <head>
    <BaseHead title="AG | Blog" description="..." />
    <BlogHead />
    <style is:global>
      .wrapper {
        box-sizing: border-box;
        width: 100%;
        max-width: min(80ch, 90dvw);
        min-height: 100dvh;
        margin: 0 auto;
        padding: 4em 1em 1em 1em;
        display: flex;
        flex-direction: column;
        gap: 1em;
      }

      .bamboo {
        position: fixed;
        z-index: -1;
        opacity: 0.1;
        bottom: 0;
        right: -5rem;
        width: clamp(50vw, 40rem, 100%);
        height: auto;
      }

      :root[data-theme="dark"] .bamboo {
        opacity: 0.075;
      }

      svg {
        width: 75%;
      }

      @media screen and (max-width: 480px) {
        svg {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <Menu />
    <Bamboo class:list={["bamboo"]} />
    <main class="wrapper">
      <h1 class="sr-only">Chie no Mori</h1>
      <svg
        viewBox="0 0 105 30"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <text
          x="0"
          y="20"
          textLength="105"
          lengthAdjust="spacing"
          fill="currentColor"
          font-family="Okashi-Regular"
          font-weight="bold">Chie no Mori</text
        >
      </svg>
      <slot />
    </main>
  </body>
</html>
