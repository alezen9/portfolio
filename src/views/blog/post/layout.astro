---
import BaseHead from "@components/ui/BaseHead.astro";
import Menu from "@components/ui/Menu.astro";
import { type CollectionEntry } from "astro:content";
import BlogHead from "../BlogHead.astro";
import TableOfContents from "./TableOfContents.svelte";
import ScrollToTop from "./ScrollToTop.svelte";
import Background from "../Background.astro";

import "./post.css";
import "katex/dist/katex.min.css";

type Props = CollectionEntry<"blog">["data"];

const { title, description, ogImageSrc, pubDate, updatedDate, state, tags } =
  Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = ogImageSrc ? new URL(ogImageSrc, Astro.site) : undefined;
const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(imageURL && { image: imageURL.href }),
  keywords: tags,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
  author: {
    "@type": "Person",
    name: "Aleksandar Gjoreski",
    url: new URL("/about-me/", Astro.site).href,
  },
};
---

<html lang="en" data-theme="dark">
  <head>
    <BaseHead
      title={`AG | ${title}`}
      description={description}
      imageSrc={ogImageSrc}
      ogType="article"
    />
    {state === "Draft" && <meta name="robots" content="noindex" />}
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
    <meta
      property="article:author"
      content={new URL("/about-me/", Astro.site).href}
    />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleStructuredData)}
    />
    <BlogHead />

    <style>
      html {
        scroll-padding: 6em;
      }
      .wrapper {
        box-sizing: border-box;
        width: 100%;
        max-width: min(80ch, 100dvw);
        min-height: 100dvh;
        margin: 0 auto;
        padding: 2em;
      }

      @media screen and (max-width: 480px) {
        .wrapper {
          padding: 1.5em;
        }
      }
    </style>
  </head>
  <body>
    <Background />
    <Menu />
    <TableOfContents client:load />
    <ScrollToTop client:only="svelte" />

    <main class="wrapper">
      <div id="article">
        <slot />
      </div>
    </main>
  </body>
</html>
