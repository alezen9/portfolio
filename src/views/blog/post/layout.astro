---
import BaseHead from "@components/ui/BaseHead.astro";
import Menu from "@components/ui/Menu.astro";
import { type CollectionEntry } from "astro:content";
import BlogHead from "../BlogHead.astro";
import TableOfContents from "./TableOfContents.svelte";
import "./post.css";
import "katex/dist/katex.min.css";

type Props = CollectionEntry<"blog">["data"];

const { title, description, ogImageSrc } = Astro.props;
---

<html lang="en" data-theme="dark">
  <head>
    <BaseHead
      title={`AG | ${title}`}
      description={description}
      imageSrc={ogImageSrc}
    />
    <BlogHead />

    <style>
      html {
        scroll-padding: 6em;
      }
      .wrapper {
        box-sizing: border-box;
        width: 100%;
        max-width: min(80ch, 100dvw);
        min-height: 100dvh;
        margin: 0 auto;
        padding: 2em;
      }

      @media screen and (max-width: 480px) {
        .wrapper {
          padding: 1.5em;
        }
      }
    </style>
  </head>
  <body>
    <Menu />
    <TableOfContents client:load="svelte" />
    <main class="wrapper">
      <div id="article">
        <slot />
      </div>
    </main>
  </body>
</html>
