---
import BaseHead from "@components/ui/BaseHead.astro";
import MangaPanelRotator from "./MangaPanelRotator.svelte";
import Menu from "@components/ui/Menu.astro";
---

<html lang="en" data-theme="dark">
  <head>
    <BaseHead
      title="AG | Home"
      description="Creative front-end engineer exploring fast web apps, WebGL/WebGPU experiments and polished user experiences."
      imageSrc="/og-images/home.jpg"
    />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Aleksandar Gjoreski",
        "alternateName": "Aleks Gjoreski",
        "url": "https://aleksandargjoreski.dev",
        "image": "https://aleksandargjoreski.dev/me.jpg",
        "jobTitle": "Frontend Engineer",
        "brand": {
          "@type": "Brand",
          "name": "Aleksandar Gjoreski",
          "logo": "https://aleksandargjoreski.dev/logo.svg"
        },
        "knowsAbout": [
          "Frontend Engineering",
          "Web Development",
          "React",
          "TypeScript",
          "JavaScript",
          "HTML",
          "CSS",
          "Three.js",
          "WebGL",
          "WebGPU",
          "3D Graphics",
          "Astro",
          "Tailwind CSS",
          "Godot"
        ],
        "sameAs": [
          "https://github.com/alezen9",
          "https://www.linkedin.com/in/aleksandar-d-gjoreski/",
          "https://x.com/aleksgjoreski"
        ]
      }
    </script>
    <style>
      .initial-bg {
        --init-bg-opacity: 0.1;
        position: relative;
      }

      .initial-bg::before {
        position: fixed;
        inset: 0;
        content: "";
        /* x 64 */
        background-image: url("data:image/webp;base64,");

        /* x 320 */
        /* background-image: url("data:image/webp;base64,"); */
        background-position: center;
        background-size: cover;
        filter: blur(4px);
        opacity: var(--init-bg-opacity);
        transition: opacity 0.5s ease-in-out;
      }
    </style>
  </head>
  <body class="initial-bg">
    <Menu />
    <MangaPanelRotator client:only="svelte" />
    <slot />
  </body>
</html>
