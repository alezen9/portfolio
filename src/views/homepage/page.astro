---
import IconLinkedIn from "@components/icons/IconLinkedIn.astro";
import IconGitHub from "@components/icons/IconGitHub.astro";
import IconX from "@components/icons/IconX.astro";
import CopyrightsDisclaimer from "@components/ui/CopyrightsDisclaimer.astro";
import WordSwap from "./WordSwap.astro";
import Layout from "./layout.astro";
---

<style>
  .hero {
    position: fixed;
    box-sizing: border-box;
    height: 100dvh;
    padding: 5em 2em 2em 2em;
    width: 100%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero::before {
    position: fixed;
    top: 0;
    left: 0;
    content: "";
    width: 100%;
    height: 100dvh;
    max-width: min(750px, 100%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(
      to right,
      var(--background-color),
      65%,
      transparent
    );
    z-index: -1;
  }

  .header {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 2em;
  }

  .tagline {
    margin-bottom: 0.1em;
  }

  .signature {
    width: fit-content;
    font-size: 0.85em;
    font-weight: 300;
  }

  .typewriter {
    /* --chars: 46;
    --real-steps: calc(var(--chars) * 3); */
    position: relative;
    border-right: 1ch solid var(--text-color);
    white-space: nowrap;
    overflow: hidden;
    animation:
      typewriterProgression 1.5s 1s 1 normal both,
      blinkingCursor 0.75s infinite normal;
    animation-timing-function: linear; /* or use steps(var(--real-steps)) and tweak multiplier */
  }

  .intro {
    margin-top: 2em;
    display: grid;
    grid-template-columns: 1fr;
    font-weight: 200;
    font-size: 0.75em;
  }

  .nav-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5em;
  }

  .personal-links {
    display: flex;
    gap: 1em;
    align-items: center;
  }

  .icon-github {
    width: 1.75em;
  }

  .icon-x {
    width: 1.25em;
  }

  .arrow-link {
    position: relative;
    width: fit-content;
    color: currentColor;
    text-decoration: none;
    font-family: var(--font-mono);
    letter-spacing: 3px;
    font-weight: 500;
  }
  .arrow-link::before {
    position: absolute;
    content: "";
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.2s ease-in-out;
    will-change: transform;
    background-color: var(--text-color);
  }

  .arrow-link::after {
    --size: 4px;
    position: absolute;
    content: "";
    bottom: calc((var(--size) / 2) * -1);
    right: -10%;
    transform: rotate(45deg);
    border-top: 1px solid;
    border-right: 1px solid;
    width: var(--size);
    height: var(--size);
    opacity: 0;
    will-change: opacity;
  }

  .arrow-link:hover::before {
    transform: scaleX(1.1);
  }

  .arrow-link:hover::after {
    opacity: 1;
    transition: opacity 0.2s ease-in-out 0.1s;
  }
  @keyframes typewriterProgression {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }
  @keyframes blinkingCursor {
    from {
      border-right-color: var(--text-color);
    }
    to {
      border-right-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter {
      animation: none;
      border: none;
    }
  }

  @media screen and (max-width: 480px) {
    .hero {
      padding: 3em 1.5em;
    }

    .tagline {
      font-size: 2.25em;
    }

    .typewriter {
      font-size: 0.85em;
    }
  }

  @media screen and (max-width: 400px) {
    .tagline {
      font-size: 2em;
    }
  }
</style>

<Layout>
  <main class="hero">
    <div class="header">
      <h1 class="tagline">Pixels set&nbsp;in motion</h1>
      <div class="signature">
        <p class="typewriter">
          Aleksandar Gjoreski | Creative Frontend Engineer
        </p>
      </div>
      <div class="intro">
        <p>
          Pixels keep me busy, <WordSwap /> one day, plain CSS the next and sometimes
          just trimming a React bundle.
        </p>
        <p>
          I go after quick loads and steady frames, polishing the details no one
          notices...until they do.
        </p>
        <p>
          When something clicks, I write down the path so the next wanderer,
          often future-me, can skip the detours.
        </p>
      </div>
    </div>
    <div class="footer">
      <div class="nav-links">
        <a
          class="arrow-link"
          href="/blog"
          title="Wander through learnings and discoveries">Blog</a
        >
        <a
          class="arrow-link"
          href="/projects"
          title="Explore some of my side projects">Projects</a
        >
        <a
          class="arrow-link"
          href="/about-me"
          title="Learn a little more about my journey">About me</a
        >
      </div>
      <div class="personal-links">
        <a
          class="icon-link"
          href="https://www.linkedin.com/in/aleksandar-d-gjoreski/"
          target="_blank"
          title="Connect with me on LinkedIn"
        >
          <IconLinkedIn class:list={["animate"]} />
        </a>
        <a
          class="icon-link"
          href="https://github.com/alezen9"
          target="_blank"
          title="Check out my work on GitHub"
        >
          <IconGitHub class:list={["animate", "icon-github"]} />
        </a>
        <a
          class="icon-link"
          href="https://x.com/aleksgjoreski"
          target="_blank"
          title="Find me on X"
        >
          <IconX class:list={["animate", "icon-x"]} />
        </a>
      </div>
      <CopyrightsDisclaimer />
    </div>
  </main>
</Layout>
