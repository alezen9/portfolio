---
type Props = {
  color?: "blue" | "green";
  delayAnimationSeconds?: number;
  rotate?: "clockwise" | "counterclockwise";
};

const {
  color = "blue",
  delayAnimationSeconds = 0,
  rotate,
  ...rest
} = Astro.props;

const SABER_COLORS = {
  blue: "#4BC9FF",
  green: "#2FF924",
};

const rotationDirection = !rotate ? 0 : rotate === "clockwise" ? 1 : -1;
---

<style
  define:vars={{
    "saber-color": SABER_COLORS[color],
    delay: delayAnimationSeconds,
    "rotation-direction": rotationDirection,
  }}
>
  svg {
    --saber-core: #fefeff;
    height: 1em;
    width: auto;
    transform-origin: center 92.5%;
    animation: swing 1s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    animation-delay: calc(1.5s + var(--delay, 0) * 1s + 5s);
  }

  .saber path.primary {
    fill: var(--saber-core, white);
  }

  .saber path.secondary {
    stroke: var(--saber-color, white);
    filter: contrast(1.5);
  }

  .saber path {
    transform-origin: center 70%;
    translate: 0 0.075em;
    scale: 0.5 0;
    rotate: 0deg;
    will-change: scale;
    animation: ignite 0.75s ease-in-out forwards;
    animation-delay: calc(1.5s + var(--delay, 0) * 1s);
  }

  .dot {
    transform-origin: center 97.5%;
    scale: 0.8;
  }

  .dot-gradient {
    border-radius: 0.1em;
    background: conic-gradient(
      from 90deg,
      rgba(139, 139, 139, 1) 0deg,
      rgba(217, 217, 217, 1) 45deg,
      rgba(115, 115, 115, 1) 169.615deg,
      rgba(217, 217, 217, 1) 226.731deg,
      rgba(115, 115, 115, 1) 346.154deg,
      rgba(139, 139, 139, 1) 360deg
    );
    opacity: 1;
    height: 100%;
    width: 100%;
  }

  @keyframes ignite {
    to {
      scale: 1 0.75;
    }
  }

  @keyframes swing {
    to {
      rotate: calc(360deg * var(--rotation-direction));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg {
      animation: none;
    }
    .saber path {
      animation: none;
      scale: 1 0.75;
    }
  }
</style>

<svg
  viewBox="0 0 47 130"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  <foreignObject x="13.5" y="110" width="20" height="20">
    <div class="dot-gradient"></div>
  </foreignObject>

  <g class="saber" filter="url(#filter0_f_192_31)">
    <path class="primary" d="M10 10H37L34 96H13L10 10Z"></path>
    <path
      class="secondary"
      d="M33.8936 13L31.1025 93H15.8975L13.1064 13H33.8936Z"
      stroke-width="6"></path>
  </g>
  <defs>
    <filter
      id="filter0_f_192_31"
      x="0"
      y="0"
      width="47"
      height="130"
      filterUnits="userSpaceOnUse"
      color-interpolation-filters="sRGB"
    >
      <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
      <feBlend
        mode="normal"
        in="SourceGraphic"
        in2="BackgroundImageFix"
        result="shape"></feBlend>
      <feGaussianBlur stdDeviation="5" result="effect1_foregroundBlur_192_31"
      ></feGaussianBlur>
    </filter>
  </defs>
</svg>

