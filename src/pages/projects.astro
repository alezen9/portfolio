---
import GodOfWarLayout from "src/layouts/GodOfWarLayout.astro";
import IconEternalLink from "@components/icons/IconEternalLink.astro";
import IconGitHub from "@components/icons/IconGitHub.astro";
---

<style>
  .project {
    --padding: 2em;
    display: grid;
    grid-template-areas: "hero mosaic";
    grid-template-columns: 1fr 1fr;
    padding: var(--padding);
    gap: 2em;
  }

  .project .mosaic {
    display: grid;
    grid-area: mosaic;
    gap: 0.25em;
    padding: 5.5em 0 0 0;
  }

  .project .mosaic div {
    --border-radius: 0.75em;
    width: 100%;
    height: 100%;
    background-image: var(--img);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  .revo-realms .mosaic {
    grid-template-areas:
      ". d d b b"
      "c c . b b"
      "c c a a a"
      "c c a a a"
      ". . a a a";
  }

  .revo-realms .mosaic div {
    background-position-y: top;
  }

  .revo-realms .mosaic div:first-of-type {
    grid-area: a;
    border-bottom-left-radius: var(--border-radius);
    border-bottom-right-radius: var(--border-radius);
  }

  .revo-realms .mosaic div:nth-of-type(2) {
    grid-area: b;
    border-top-right-radius: var(--border-radius);
  }

  .revo-realms .mosaic div:nth-of-type(3) {
    grid-area: c;
    border-top-left-radius: var(--border-radius);
    border-bottom-left-radius: var(--border-radius);
  }

  .revo-realms .mosaic div:nth-of-type(4) {
    grid-area: d;
    border-top-left-radius: var(--border-radius);
  }

  .zanka-no-tachi .mosaic {
    grid-template-areas:
      ". . b b b"
      ". . b b b"
      "a a a a ."
      "a a a a ."
      "a a a a .";
  }

  .zanka-no-tachi .mosaic div:first-of-type {
    grid-area: a;
    border-radius: var(--border-radius);
    border-top-right-radius: 0;
  }

  .zanka-no-tachi .mosaic div:nth-of-type(2) {
    grid-area: b;
    border-radius: var(--border-radius);
    border-bottom-left-radius: 0;
  }

  .unshaken .mosaic {
    grid-template-areas:
      ". a a a a"
      "c a a a a"
      "c a a a a"
      "c b b . ."
      ". b b . .";
  }

  .unshaken .mosaic div:first-of-type {
    grid-area: a;
    border-radius: var(--border-radius);
    border-bottom-left-radius: 0;
  }

  .unshaken .mosaic div:nth-of-type(2) {
    grid-area: b;
    border-bottom-right-radius: var(--border-radius);
    border-bottom-left-radius: var(--border-radius);
  }

  .unshaken .mosaic div:nth-of-type(3) {
    grid-area: c;
    border-top-left-radius: var(--border-radius);
    border-bottom-left-radius: var(--border-radius);
  }

  .cosmic-canvas .mosaic {
    grid-template-areas:
      "a a a . ."
      "a a a b b"
      "c c c b b"
      "c c c b b"
      "c c c . .";
  }

  .cosmic-canvas .mosaic div,
  .revo-realms .mosaic div {
    filter: brightness(1.5);
  }

  .unshaken .mosaic div,
  .zanka-no-tachi .mosaic div {
    filter: saturate(1.25);
  }

  .cosmic-canvas .mosaic div:first-of-type {
    grid-area: a;
    border-top-left-radius: var(--border-radius);
    border-top-right-radius: var(--border-radius);
  }

  .cosmic-canvas .mosaic div:nth-of-type(2) {
    grid-area: b;
    border-top-right-radius: var(--border-radius);
    border-bottom-right-radius: var(--border-radius);
  }

  .cosmic-canvas .mosaic div:nth-of-type(3) {
    grid-area: c;
    border-bottom-left-radius: var(--border-radius);
    border-bottom-right-radius: var(--border-radius);
  }

  .project .hero {
    grid-area: hero;
    background-color: var(--background-color);
    height: 100%;
    max-width: max(500px, 100%);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1em;
    z-index: 1;
    padding-right: 5em;
  }

  .revo-realms .hero {
    --text-accent: rgb(143, 116, 87);
  }

  .zanka-no-tachi .hero {
    --text-accent: rgb(217, 101, 48);
  }

  .unshaken .hero {
    --text-accent: rgb(196, 6, 16);
  }

  .cosmic-canvas .hero {
    --text-accent: rgb(205, 156, 7);
  }

  .project .hero .title {
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
    color: var(--text-accent);
    margin-bottom: 0.5em;
  }

  .project .hero p,
  .project .hero ul {
    font-size: 0.9em;
    text-align: justify;
    max-width: 100%;
  }

  .project .hero ul {
    position: relative;
    margin-top: 2em;
    list-style-type: square;
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  .project .hero ul li {
    position: relative;
  }

  .project .hero ul li::before {
    --bg: color-mix(in srgb, var(--text-accent) 10%, var(--background-color));
    position: absolute;
    content: "";
    inset: -0.25em -1em;
    background: linear-gradient(
      to right,
      transparent,
      var(--bg) 7.5%,
      transparent 75%
    );
    z-index: -1;
  }

  .project .hero h3 {
    font-size: 1em;
  }

  .project .hero .links {
    display: flex;
    gap: 1em;
    align-items: end;
  }

  .icon-github {
    width: 1.75em;
  }

  .icon-demo {
    width: 1.5em;
  }

  .highlight {
    filter: grayscale(0.25) saturate(3);
  }

  @media (orientation: portrait) {
    .project {
      grid-template-areas: "mosaic" "hero";
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      gap: 2em;
    }

    .project .hero {
      min-height: max(300px, 100%);
      padding: 0;
    }

    .project .hero .title {
      font-size: 2.25em;
    }

    .project .hero .description {
      max-width: 100%;
    }

    .project .mosaic {
      padding-top: 0;
    }
  }

  @media screen and (max-width: 1200px) {
    .project .hero .title {
      font-size: 2.25em;
    }
  }

  @media screen and (max-width: 720px) {
    .project .mosaic {
      grid-template-areas: "a";
      height: 20vh;
    }
    .project .mosaic div:not(:first-of-type) {
      display: none;
    }
    .project .mosaic div:first-of-type {
      position: relative;
      border-radius: var(--border-radius);
      background-image: none;
    }

    .project .mosaic div:first-of-type::before {
      position: absolute;
      content: "";
      inset: calc(var(--padding) * -1);
      bottom: 0;
      background-image: var(--img);
      background-size: cover;
      background-position: center;
      z-index: 1;
    }
  }

  @media screen and (orientation: portrait) and (max-width: 430px) {
    .project .mosaic {
      height: 30vh;
    }
    .project .hero .highlights {
      display: none;
    }
  }
</style>
<GodOfWarLayout title="AG | Personal Projects" description="...">
  <li class="slide">
    <div class="content project revo-realms">
      <div class="hero">
        <header>
          <h2 class="title">Revo Realms</h2>
          <p class="description">
            Born as an open-world 3D portfolio, Revo Realms grew into a personal
            sandbox for testing advanced WebGPU effects, physics, and scene
            optimization. Built with <code>Three.js</code>
            and vanilla TypeScript, it mixes interactive terrain, procedural vegetation,
            water, fire, and dynamic audio into a performance-driven playground—sprinkled
            with a few subtle references to the worlds, stories, and games I love.
          </p>
          <ul class="highlights">
            <li>
              <span class="highlight">Built</span> GPU-driven grass & flowers with
              instancing, compute shaders, and soft culling.
            </li>
            <li>
              <span class="highlight">Optimized</span> third-party models in Blender
              by reducing polycounts, removing unseen geometry, and creating texture
              atlases via external tools.
            </li>
            <li>
              <span class="highlight">Experimented</span> with water rendering techniques,
              from vertex displacement to normal-based shading.
            </li>
            <li>
              <span class="highlight">Structured</span> a lightweight Rapier physics
              system tuned for stable, real-time simulation.
            </li>
            <li>
              <span class="highlight">Added</span> spatial audio effects tied to
              physics events for environmental feedback.
            </li>
            <li>
              <span class="highlight">Designed</span> an efficient fire particle
              pool, reusing particles and blending colors to convey heat and depth.
            </li>
          </ul>
        </header>
        <footer class="links">
          <a
            class="icon-link"
            href="https://github.com/alezen9/revo-realms"
            target="_blank"
          >
            <IconGitHub class:list={["animate", "icon-github"]} />
          </a>
          <a
            class="icon-link"
            href="https://alezen9.github.io/revo-realms/"
            target="_blank"
          >
            <IconEternalLink
              class:list={["animate", "icon-demo", "icon-demo"]}
            />
          </a>
        </footer>
      </div>
      <div class="mosaic">
        <div style="--img: url(/portfolio/projects/revo-realms/a.webp);"></div>
        <div style="--img: url(/portfolio/projects/revo-realms/b.webp);"></div>
        <div style="--img: url(/portfolio/projects/revo-realms/c.webp);"></div>
        <div style="--img: url(/portfolio/projects/revo-realms/d.webp);"></div>
      </div>
    </div>
  </li>

  <li class="slide">
    <div class="content project zanka-no-tachi">
      <div class="hero">
        <header>
          <h2 class="title">Zanka no Tachi</h2>
          <p class="description">
            A real-time tribute to <span class="highlight"
              >Yamamoto Genryūsai's Bankai</span
            > from Bleach, built with <code>R3F</code> and <code>Three.js</code
            >. I focused on a stylized, dynamic fire effect and a simple
            low-poly environment, wiring GPGPU powered particle systems, custom
            shaders and Blender-modeled assets to capture the raw power of that
            iconic moment.
          </p>
          <ul class="highlights">
            <li>
              <span class="highlight">Built</span> a <code>useGPGpu</code> hook to
              declaratively manage <code>WebGL2</code> compute shaders, buffers,
              and dispatch.
            </li>
            <li>
              <span class="highlight">Routed</span> flame particles along <code
                >CatmullRomCurve3</code
              >, replacing an early manual layout.
            </li>
            <li>
              <span class="highlight">Composed</span> post-processing passes to layer
              in smoke and subtle blade-edge heat distortion.
            </li>
            <li>
              <span class="highlight">Modeled</span> every asset—including Yamamoto
              himself using manga as refs in a cohesive low-poly style.
            </li>
            <li>
              <span class="highlight">Created</span> a <code
                >usePositionalAudio</code
              > hook to orchestrate spatialized fire crackle, voice lines, and expansion
              sound effects.
            </li>
            <li>
              <span class="highlight">Masked</span> procedural <code>GLSL</code>
              shaders (circular → hexagonal) on-the-fly to shape each particle without
              any sprite textures.
            </li>
          </ul>
        </header>
        <footer class="links">
          <a
            class="icon-link"
            href="https://github.com/alezen9/zanka-no-tachi"
            target="_blank"
          >
            <IconGitHub class:list={["animate", "icon-github"]} />
          </a>
          <a
            class="icon-link"
            href="https://alezen9.github.io/zanka-no-tachi/"
            target="_blank"
          >
            <IconEternalLink class:list={["animate", "icon-demo"]} />
          </a>
        </footer>
      </div>
      <div class="mosaic">
        <div style="--img: url(/portfolio/projects/zanka-no-tachi/a.webp);">
        </div>
        <div style="--img: url(/portfolio/projects/zanka-no-tachi/b.webp);">
        </div>
      </div>
    </div>
  </li>

  <li class="slide">
    <div class="content project unshaken">
      <div class="hero">
        <header>
          <h2 class="title">Unshaken</h2>
          <p class="description">
            A low-poly homage to one of the best videogame experiences ever
            created: Red Dead Redemption II. Brought to life with <code
              >Three.js</code
            > (via <code>R3F</code>), built and baked in <code>Blender</code>,
            it depicts Arthur Morgan riding his horse down a hill beneath the
            warm colors of dawn.
          </p>
          <ul class="highlights">
            <li>
              <span class="highlight">Modeled</span> all low-poly assets in Blender,
              from rocks and grass to the horse and Arthur, using tools like mirror
              and boolean modifiers.
            </li>
            <li>
              <span class="highlight">Unwrapped</span> complex UVs with a focus on
              optimizing texture atlases while minimizing visible seams.
            </li>
            <li>
              <span class="highlight">Lit</span> the scene with the <code
                >&ltSky /&gt</code
              >
              component to replicate the dramatic dawn effect achieved in Blender
              with Nishita Sky.
            </li>
            <li>
              <span class="highlight">Integrated</span> Git LFS into the workflow
              to efficiently manage large Blender files.
            </li>
          </ul>
        </header>
        <footer class="links">
          <a
            class="icon-link"
            href="https://github.com/alezen9/unshaken"
            target="_blank"
          >
            <IconGitHub class:list={["animate", "icon-github"]} />
          </a>
          <a
            class="icon-link"
            href="https://alezen9.github.io/unshaken/"
            target="_blank"
          >
            <IconEternalLink class:list={["animate", "icon-demo"]} />
          </a>
        </footer>
      </div>
      <div class="mosaic">
        <div style="--img: url(/portfolio/projects/unshaken/a.webp);"></div>
        <div style="--img: url(/portfolio/projects/unshaken/b.webp);"></div>
        <div style="--img: url(/portfolio/projects/unshaken/c.webp);"></div>
      </div>
    </div>
  </li>

  <li class="slide">
    <div class="content project cosmic-canvas">
      <div class="hero">
        <header>
          <h2 class="title">Cosmic Canvas</h2>
          <p class="description">
            My first solo <code>Three.js</code> project (via <code>R3F</code>):
            a shader driven study of Jupiter. The goal was simple—recreate the
            planet's swirling bands with a single, compact shader and keep it
            silky smooth even on potato devices. No textures, just procedural
            noise, flow, and custom lighting.
          </p>
          <ul class="highlights">
            <li>
              <span class="highlight">Implemented</span> a compact <code
                >GLSL</code
              > material that layers animated noise to drive Jupiter's banding and
              storm motion.
            </li>
            <li>
              <span class="highlight">Added</span> rim (Fresnel) and specular highlights,
              with a softened day-night terminator to sell curvature and depth.
            </li>
            <li>
              <span class="highlight">Orbit-rendered</span> four of Jupiter's largest
              moons, each using adapted parts of the planet shader for surface detail.
            </li>
            <li>
              <span class="highlight">Framed</span> the scene with <code
                >Drei</code
              >'s <code>&ltStars /&gt</code> and
              <code>&ltTrail /&gt</code> components, making the small-scale satellites
              easy to spot.
            </li>
          </ul>
        </header>
        <footer class="links">
          <a
            class="icon-link"
            href="https://github.com/alezen9/cosmic-canvas"
            target="_blank"
          >
            <IconGitHub class:list={["animate", "icon-github"]} />
          </a>
          <a
            class="icon-link"
            href="https://alezen9.github.io/cosmic-canvas/"
            target="_blank"
          >
            <IconEternalLink class:list={["animate", "icon-demo"]} />
          </a>
        </footer>
      </div>
      <div class="mosaic">
        <div style="--img: url(/portfolio/projects/cosmic-canvas/a.webp);">
        </div>
        <div style="--img: url(/portfolio/projects/cosmic-canvas/b.webp);">
        </div>
        <div style="--img: url(/portfolio/projects/cosmic-canvas/c.webp);">
        </div>
      </div>
    </div>
  </li>
</GodOfWarLayout>
