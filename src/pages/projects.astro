---
import GodOfWarLayout from "src/layouts/GodOfWarLayout.astro";
import IconEye from "@components/icons/IconEye.astro";
import IconGitHub from "@components/icons/IconGitHub.astro";
---

<style>
  .project {
    display: grid;
    grid-template-areas: "hero mosaic";
    grid-template-columns: 1fr 1fr;
    padding: 2em;
    gap: 2em;
  }

  .project .mosaic {
    display: grid;
    grid-area: mosaic;
    gap: 0.25em;
    padding: 5.5em 0 0 0;
  }

  .project .mosaic div {
    --border-radius: 0.75em;
    width: 100%;
    height: 100%;
    background-image: var(--img);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  .revo-realms .mosaic {
    grid-template-areas:
      ". d d b b"
      "c c . b b"
      "c c a a a"
      "c c a a a"
      ". . a a a";
  }

  .revo-realms .mosaic div {
    background-position-y: top;
  }

  .revo-realms .mosaic div:first-of-type {
    grid-area: a;
    border-radius: var(--border-radius);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .revo-realms .mosaic div:nth-of-type(2) {
    grid-area: b;
    border-top-right-radius: var(--border-radius);
  }

  .revo-realms .mosaic div:nth-of-type(3) {
    grid-area: c;
    border-top-left-radius: var(--border-radius);
    border-bottom-left-radius: var(--border-radius);
  }

  .revo-realms .mosaic div:nth-of-type(4) {
    grid-area: d;
    border-top-left-radius: var(--border-radius);
  }

  .zanka-no-tachi .mosaic {
    grid-template-areas:
      ". . b b b"
      ". . b b b"
      "a a a a ."
      "a a a a ."
      "a a a a .";
  }

  .zanka-no-tachi .mosaic div:first-of-type {
    grid-area: a;
    border-radius: var(--border-radius);
    border-top-right-radius: 0;
  }

  .zanka-no-tachi .mosaic div:nth-of-type(2) {
    grid-area: b;
    border-radius: var(--border-radius);
    border-bottom-left-radius: 0;
  }

  .unshaken .mosaic {
    grid-template-areas:
      ". a a a a"
      "c a a a a"
      "c a a a a"
      "c b b . ."
      ". b b . .";
  }

  .unshaken .mosaic div:first-of-type {
    grid-area: a;
    border-radius: var(--border-radius);
    border-bottom-left-radius: 0;
  }

  .unshaken .mosaic div:nth-of-type(2) {
    grid-area: b;
    border-bottom-right-radius: var(--border-radius);
    border-bottom-left-radius: var(--border-radius);
  }

  .unshaken .mosaic div:nth-of-type(3) {
    grid-area: c;
    border-top-left-radius: var(--border-radius);
    border-bottom-left-radius: var(--border-radius);
  }

  .cosmic-canvas .mosaic {
    grid-template-areas:
      "a a a . ."
      "a a a b b"
      "c c c b b"
      "c c c b b"
      "c c c . .";
  }

  .cosmic-canvas .mosaic div:first-of-type {
    grid-area: a;
    border-top-left-radius: var(--border-radius);
    border-top-right-radius: var(--border-radius);
  }

  .cosmic-canvas .mosaic div:nth-of-type(2) {
    grid-area: b;
    border-top-right-radius: var(--border-radius);
    border-bottom-right-radius: var(--border-radius);
  }

  .cosmic-canvas .mosaic div:nth-of-type(3) {
    grid-area: c;
    border-bottom-left-radius: var(--border-radius);
    border-bottom-right-radius: var(--border-radius);
  }

  .project .hero {
    grid-area: hero;
    background-color: var(--background-color);
    height: 100%;
    max-width: max(500px, 100%);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: 1;
  }

  .revo-realms .hero {
    --text-accent: rgb(143, 116, 87);
  }

  .zanka-no-tachi .hero {
    --text-accent: rgb(217, 101, 48);
  }

  .unshaken .hero {
    --text-accent: rgb(212, 25, 54);
  }

  .cosmic-canvas .hero {
    --text-accent: var(--text-color);
  }

  .project .hero .title {
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
    color: var(--text-accent);
  }

  .project .hero .description {
    margin-top: 2em;
    font-size: 0.75em;
    font-weight: 200;
    text-align: justify;
  }

  .project .hero .links {
    display: flex;
    gap: 1em;
    align-items: center;
  }

  .icon-github {
    width: 1.75em;
  }

  @media (orientation: portrait) {
    .project {
      grid-template-areas: "mosaic" "hero";
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      padding: 2em;
      gap: 2em;
    }

    .project .hero {
      min-height: max(300px, 100%);
    }

    .project .hero .title {
      font-size: 2.25em;
    }

    .project .hero .description {
      max-width: 100%;
    }

    .project .mosaic {
      padding-top: 0;
    }
  }

  @media screen and (max-width: 1200px) {
    .project .hero .title {
      font-size: 2.25em;
    }
  }
</style>
<GodOfWarLayout title="AG | Personal Projects" description="...">
  <li class="slide">
    <div class="content project revo-realms">
      <div class="hero">
        <header>
          <h2 class="title">Revo Realms</h2>
          <p class="description">
            Revo Realms began life as an open-world 3D portfolio game built in
            Three.js, then evolved into a sandbox playground for pushing the
            limits of WebGPU and TypeScript. You can wander a simple terrain,
            but really it's a testbed—drop in custom shaders, swap in new
            models, and dial in lighting or physics experiments on the fly.<br
            />
            Under the hood I dove deep into GPU work: implementing frustum and occlusion
            culling, squeezing performance with frame-rate throttling, texture atlases
            and compressed GPU formats. I also got hands-on in Blender—modeling,
            UV-unwrapping and baking—and came away with a far stronger grasp of TypeScript's
            type system and shader integration.
          </p>
        </header>
        <footer class="links">
          <a
            class="icon-link"
            href="https://github.com/alezen9/revo-realms"
            target="_blank"
          >
            <IconGitHub class:list={["animate", "icon-github"]} />
          </a>
          <a
            class="icon-link"
            href="https://alezen9.github.io/revo-realms/"
            target="_blank"
          >
            <IconEye class:list={["animate"]} />
          </a>
        </footer>
      </div>
      <div class="mosaic">
        <div style="--img: url(/portfolio/projects/revo-realms/a.webp);"></div>
        <div style="--img: url(/portfolio/projects/revo-realms/b.webp);"></div>
        <div style="--img: url(/portfolio/projects/revo-realms/c.webp);"></div>
        <div style="--img: url(/portfolio/projects/revo-realms/d.webp);"></div>
      </div>
    </div>
  </li>

  <li class="slide">
    <div class="content project zanka-no-tachi">
      <div class="hero">
        <header>
          <h2 class="title">Zanka no Tachi</h2>
          <p class="description">
            Zanka no Tachi is a stylized, real-time tribute to Genryūsai
            Yamamoto's Bankai moment from manga and anime, rendered in React
            Three Fiber. I built every element in Blender—armor plates, fiery
            embers, flowing robes—and choreographed it all with GPU particle
            systems that respond to mouse and time.
            <br />
            This project forced me to master Blender sculpting and rigging, then
            translate that work into performant glTF assets. On the WebGL side I
            learned how to drive thousands of particles—controlling emission, velocity,
            lifetime and blending modes—purely on the GPU, without costly JavaScript
            loops.
          </p>
        </header>
        <footer class="links">
          <a
            class="icon-link"
            href="https://github.com/alezen9/zanka-no-tachi"
            target="_blank"
          >
            <IconGitHub class:list={["animate", "icon-github"]} />
          </a>
          <a
            class="icon-link"
            href="https://alezen9.github.io/zanka-no-tachi/"
            target="_blank"
          >
            <IconEye class:list={["animate"]} />
          </a>
        </footer>
      </div>
      <div class="mosaic">
        <div style="--img: url(/portfolio/projects/zanka-no-tachi/a.webp);">
        </div>
        <div style="--img: url(/portfolio/projects/zanka-no-tachi/b.webp);">
        </div>
      </div>
    </div>
  </li>

  <li class="slide">
    <div class="content project unshaken">
      <div class="hero">
        <header>
          <h2 class="title">Unshaken</h2>
          <p class="description">
            Unshaken is my low-poly homage to Red Dead Redemption II—a solitary
            campfire scene at dusk, complete with rustling grass and smoldering
            embers. Beyond the nostalgia, it was a solo Blender-centric build:
            every rock, twig and tent was born in my own 3D workspace.
            <br />
            Through it I reinforced UV-unwrap and texture-baking workflows—learning
            when to bake ambient occlusion or normal maps, how to optimize for minimal
            texture sets, and how to maintain visual fidelity in a low-poly aesthetic.
          </p>
        </header>
        <footer class="links">
          <a
            class="icon-link"
            href="https://github.com/alezen9/unshaken"
            target="_blank"
          >
            <IconGitHub class:list={["animate", "icon-github"]} />
          </a>
          <a
            class="icon-link"
            href="https://alezen9.github.io/unshaken/"
            target="_blank"
          >
            <IconEye class:list={["animate"]} />
          </a>
        </footer>
      </div>
      <div class="mosaic">
        <div style="--img: url(/portfolio/projects/unshaken/a.webp);"></div>
        <div style="--img: url(/portfolio/projects/unshaken/b.webp);"></div>
        <div style="--img: url(/portfolio/projects/unshaken/c.webp);"></div>
      </div>
    </div>
  </li>

  <li class="slide">
    <div class="content project cosmic-canvas">
      <div class="hero">
        <header>
          <h2 class="title">Cosmic Canvas</h2>
          <p class="description">
            Cosmic Canvas started as a mission to render the entire solar system
            one world at a time, but I paused after nailing Jupiter's swirling
            storms in a single shader. It's a WebGL/GLSL demo built in React
            Three Fiber, complete with procedural noise, rim lighting and
            seamless looping.
            <br />
            It gave me a deep dive into shader math—layering fractal noise, animating
            flow maps, blending multiple color ramps—and into R3F's <code
              >shaderMaterial</code
            > patterns (with help from Drei). The result is a compact, interactive
            piece that's as much about coding elegant GLSL as it is about planet
            design.
          </p>
        </header>
        <footer class="links">
          <a
            class="icon-link"
            href="https://github.com/alezen9/cosmic-canvas"
            target="_blank"
          >
            <IconGitHub class:list={["animate", "icon-github"]} />
          </a>
          <a
            class="icon-link"
            href="https://alezen9.github.io/cosmic-canvas/"
            target="_blank"
          >
            <IconEye class:list={["animate"]} />
          </a>
        </footer>
      </div>
      <div class="mosaic">
        <div style="--img: url(/portfolio/projects/cosmic-canvas/a.webp);">
        </div>
        <div style="--img: url(/portfolio/projects/cosmic-canvas/b.webp);">
        </div>
        <div style="--img: url(/portfolio/projects/cosmic-canvas/c.webp);">
        </div>
      </div>
    </div>
  </li>
</GodOfWarLayout>
