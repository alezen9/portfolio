---
import BaseHead from "@components/ui/BaseHead.astro";
import BlobMask from "@islands/BlobMask";
import MangaPanelBackground from "@components/MangaPanelBackground.astro";
import MangaPanelRotator from "@components/islands/mangaPanelRotator";
import panels from "@content/other/manga-panels.json" assert { type: "json" };
---

<style>
  .hero {
    box-sizing: border-box;
    height: 100dvh;
    padding: 5em 0 5em 2em;
    max-width: 720px;
    display: grid;
    grid-template-rows: 1fr;
    gap: 2em;
    background: linear-gradient(
      to right,
      var(--background-color),
      75%,
      transparent
    );
  }

  .presentation {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  .name {
    margin-bottom: 0;
  }

  .role {
    font-size: 1.1em;
  }

  .intro {
    display: grid;
    grid-template-rows: 1fr;
    font-weight: 200;
    font-size: 0.75em;
  }

  .nav-links {
    display: grid;
    grid-template-rows: 1fr;
    gap: 0.5em;
  }

  .personal-links {
    display: flex;
    gap: 1em;
    align-items: center;
  }

  .icon-link {
    width: 2em;
    aspect-ratio: 1/1;
    display: inline-block;
  }

  .icon-link svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .icon-link svg {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 8;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: animateDash 1.5s ease-in-out forwards;
  }

  @keyframes animateDash {
    to {
      stroke-dashoffset: 0;
    }
  }

  .icon-link svg.github-svg {
    width: 1.75em;
  }

  .icon-link svg.x-svg {
    width: 1.25em;
    stroke-width: 48;
  }

  .icon-link::before,
  .icon-link::after {
    display: none;
  }
</style>

<html lang="en">
  <BaseHead title="Aleksandar Gjoreski" description="..." />
  <body>
    <MangaPanelBackground id="manga-panel-bg" {...panels[0]}>
      <BlobMask client:only />
      <MangaPanelRotator client:only panelId="manga-panel-bg" panels={panels} />
    </MangaPanelBackground>
    <main class="hero">
      <div class="presentation">
        <div>
          <h1 class="name">Aleksandar Gjoreski</h1>
          <p class="role">Senior Frontend Engineer</p>
        </div>
        <div class="intro">
          <p>
            Forever tweaking pixels, some days a WebGL scene, other days nudging
            a plain CSS button or trimming a React bundle.
          </p>
          <p>
            I chase quick loads and smooth frames, polishing the details no one
            notices...until they do.
          </p>
          <p>
            Whenever the code finally behaves, I write down the path so the next
            wanderer (often future-me) can skip the detours.
          </p>
        </div>
      </div>

      <div class="nav-links">
        <a href="/blog">Blog</a>
        <a href="/about">About me</a>
      </div>
      <div class="personal-links">
        <a
          class="icon-link"
          href="https://www.linkedin.com/in/aleksandar-d-gjoreski/"
          target="_blank"
        >
          <svg
            class="linkedin-svg"
            viewBox="0 0 192 192"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
          >
            <rect
              width="132"
              height="132"
              x="30"
              y="30"
              stroke="currentColor"
              stroke-width="12"
              rx="16"></rect>
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="12"
              d="M66 86v44"></path>
            <circle cx="66" cy="64" r="8" fill="currentColor"></circle>
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="12"
              d="M126 130v-26c0-9.941-8.059-18-18-18v0c-9.941 0-18 8.059-18 18v26"
            ></path>
          </svg>
        </a>
        <a class="icon-link" href="https://github.com/alezen9" target="_blank">
          <svg
            class="github-svg"
            viewBox="0 0 192 192"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
