---
import BaseHead from "@components/ui/BaseHead.astro";
import BlobMask from "@islands/BlobMask";
import MangaPanelBackground from "@components/MangaPanelBackground.astro";
import panels from "@content/other/manga-panels.json" assert { type: "json" };

const randomPanel = panels[Math.floor(Math.random() * panels.length)];
---

<style>
  .hero {
    box-sizing: border-box;
    height: 100dvh;
    padding: 5em 10em 5em 2em;
    max-width: 35vw;
    display: grid;
    grid-template-rows: 1fr;
    gap: 2em;
    background: linear-gradient(
      to right,
      var(--background-color),
      75%,
      transparent
    );
  }

  .presentation {
    display: flex;
    flex-direction: column;
    gap: 2em;
    max-width: 720px;
  }

  .name-role {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .name {
    display: flex;
    gap: 1em;
  }

  .name h1 {
    margin-bottom: 0;
  }

  .role {
    font-size: 1.1em;
  }

  .intro {
    display: grid;
    grid-template-rows: 1fr;
    font-weight: 200;
    font-size: 0.75em;
  }

  .links {
    display: grid;
    grid-template-rows: 1fr;
    gap: 0.5em;
  }

  .initial {
    position: relative;
    display: inline-block;
    -webkit-text-fill-color: transparent;
    letter-spacing: 0.1em;
    font-size: 1.25em;
    -webkit-text-stroke: 0.5px currentColor;
  }
</style>

<html lang="en">
  <BaseHead title="Aleksandar Gjoreski" description="..." />
  <body>
    <MangaPanelBackground {...randomPanel}>
      <BlobMask client:only />
    </MangaPanelBackground>
    <main class="hero">
      <div class="presentation">
        <div class="name-role">
          <div class="name">
            <h1>Aleksandar</h1>
            <h1>Gjoreski</h1>
          </div>
          <p class="role">Senior Frontend Engineer</p>
        </div>
        <div class="intro">
          <p>
            Forever tweaking pixels, some days a WebGL scene, other days nudging
            a plain CSS button or trimming a React bundle.
          </p>
          <p>
            I chase quick loads and smooth frames, polishing the details no one
            notices...until they do.
          </p>
          <p>
            Whenever the code finally behaves, I write down the path so the next
            wanderer (often future-me) can skip the detours.
          </p>
        </div>
      </div>

      <div class="links">
        <a href="/blog">
          <span>✍🏻</span>
          <span>Blog</span>
        </a>
        <a href="/about">
          <span>🙍🏻</span>
          <span>About</span>
        </a>
      </div>
    </main>
  </body>
</html>
