---
import BaseHead from "@components/ui/BaseHead.astro";
import BlobMask from "@islands/BlobMask";
import MangaPanelBackground from "@components/MangaPanelBackground.astro";
import MangaPanelRotator from "@components/islands/mangaPanelRotator";
import panels from "@content/other/manga-panels.json" assert { type: "json" };
---

<style>
  .hero {
    box-sizing: border-box;
    height: 100dvh;
    padding: 5em 0 5em 2em;
    max-width: 720px;
    display: grid;
    grid-template-rows: 1fr;
    gap: 2em;
    background: linear-gradient(
      to right,
      var(--background-color),
      75%,
      transparent
    );
  }

  .presentation {
    display: flex;
    flex-direction: column;
    gap: 2em;
  }

  .name-role {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .name {
    display: flex;
    gap: 1em;
  }

  .name h1 {
    margin-bottom: 0;
  }

  .role {
    font-size: 1.1em;
  }

  .intro {
    display: grid;
    grid-template-rows: 1fr;
    font-weight: 200;
    font-size: 0.75em;
  }

  .links {
    display: grid;
    grid-template-rows: 1fr;
    gap: 0.5em;
  }

  a {
    width: fit-content;
    color: #05af4e;
    text-decoration: none;
    position: relative;
    padding: 2px 2px;
    transition: all 0.2s ease-out;
  }
  a:after {
    content: " ";
    width: 100%;
    height: 1px;
    background: #05af4e;
    position: absolute;
    right: 0;
    bottom: 0;
    transition: all 0.2s ease-out;
  }
  a:before {
    content: " ";
    width: 4px;
    height: 4px;
    background: #05af4e;
    position: absolute;
    right: -4px;
    bottom: 0;
    opacity: 0;
  }
  a:hover {
    background: rgba(57, 255, 20, 0.1);
    transition: all 0.1s ease-out;
    padding: 2px 8px;
  }
  a:hover:after {
    width: 0px;
    transition: all 0.1s ease-out;
  }
  a:hover:before {
    opacity: 1;
    animation: blink 0.4s infinite 0.1s;
    transition: all 0.1s ease-out;
  }

  @keyframes blink {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
</style>

<html lang="en">
  <BaseHead title="Aleksandar Gjoreski" description="..." />
  <body>
    <MangaPanelBackground id="manga-panel-bg" {...panels[0]}>
      <BlobMask client:only />
      <MangaPanelRotator client:only panelId="manga-panel-bg" panels={panels} />
    </MangaPanelBackground>
    <main class="hero">
      <div class="presentation">
        <div class="name-role">
          <!-- <div class="name">
            <h1>Aleksandar</h1>
            <h1>Gjoreski</h1>
          </div> -->
          <h1>Aleksandar Gjoreski</h1>
          <p class="role">Senior Frontend Engineer</p>
        </div>
        <div class="intro">
          <p>
            Forever tweaking pixels, some days a WebGL scene, other days nudging
            a plain CSS button or trimming a React bundle.
          </p>
          <p>
            I chase quick loads and smooth frames, polishing the details no one
            notices...until they do.
          </p>
          <p>
            Whenever the code finally behaves, I write down the path so the next
            wanderer (often future-me) can skip the detours.
          </p>
        </div>
      </div>

      <div class="links">
        <a href="/blog"> Blog </a>
        <a href="/about"> About </a>
      </div>
    </main>
  </body>
</html>
