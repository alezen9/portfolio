---
import BaseHead from "@components/ui/BaseHead.astro";
import BlobMask from "@islands/BlobMask";
import MangaPanelBackground from "@components/MangaPanelBackground.astro";
import MangaPanelRotator from "@components/islands/mangaPanelRotator";
import panels from "@content/other/manga-panels.json" assert { type: "json" };
import IconLinkedIn from "@components/ui/IconLinkedIn.astro";
import IconGitHub from "@components/ui/IconGitHub.astro";
import IconX from "@components/ui/IconX.astro";

const firstPanel = panels[0];
---

<style>
  .hero {
    box-sizing: border-box;
    min-height: 100dvh;
    padding: 5em 0 2em 2em;
    max-width: min(750px, 100dvw);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(
      to right,
      var(--background-color),
      75%,
      transparent
    );
  }

  .header {
    display: flex;
    flex-direction: column;
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 2em;
  }

  .tagline {
    margin-bottom: 0.1em;
  }

  .signature {
    width: fit-content;
    font-size: 0.85em;
    font-weight: 300;
  }

  .cursor {
  }

  .typewriter {
    /* --chars: 46;
    --real-steps: calc(var(--chars) * 3); */
    position: relative;
    border-right: 1ch solid var(--text-color);
    white-space: nowrap;
    overflow: hidden;
    animation:
      typewriterProgression 1.5s 1s 1 normal both,
      blinkingCursor 0.75s infinite normal;
    animation-timing-function: linear; /* or use steps(var(--real-steps)) and tweak multiplier */
  }

  .intro {
    margin-top: 2em;
    display: grid;
    grid-template-columns: 1fr;
    font-weight: 200;
    font-size: 0.75em;
  }

  .nav-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5em;
  }

  .personal-links {
    display: flex;
    gap: 1em;
    align-items: center;
  }

  .icon-link {
    width: 2em;
    aspect-ratio: 1/1;
    display: inline-block;
  }

  .disclaimer {
    font-size: 0.7rem;
    opacity: 0.6;
    font-family: "RedHatText";
    font-weight: 300;
    margin-bottom: 0;
  }

  .disclaimer a {
    letter-spacing: 1px;
    font-weight: 300;
  }

  .icon-link::before,
  .icon-link::after,
  .disclaimer a::before,
  .disclaimer a::after {
    display: none;
  }
  @keyframes typewriterProgression {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }
  @keyframes blinkingCursor {
    from {
      border-right-color: var(--text-color);
    }
    to {
      border-right-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter {
      animation: none;
      border: none;
    }
  }

  @media screen and (max-width: 480px) {
    .hero {
      padding: 4em 1.5em;
    }

    .tagline {
      font-size: 2.25em;
    }

    .typewriter {
      font-size: 0.85em;
    }
  }
</style>

<html lang="en">
  <BaseHead title="Aleksandar Gjoreski" description="..." />
  <body>
    <MangaPanelBackground id="manga-panel-bg" firstPanel={firstPanel}>
      <BlobMask client:only />
      <MangaPanelRotator client:only panelId="manga-panel-bg" panels={panels} />
    </MangaPanelBackground>
    <main class="hero">
      <div class="header">
        <h1 class="tagline">Pixels set in motion</h1>
        <div class="signature">
          <p class="typewriter">Aleksandar Gjoreski | Sr. Frontend Engineer</p>
        </div>
        <div class="intro">
          <p>
            Pixels keep me busy, WebGL one day, plain CSS the next and sometimes
            just trimming a React bundle.
          </p>
          <p>
            I go after quick loads and steady frames, polishing the details no
            one notices...until they do.
          </p>
          <p>
            When something clicks, I write down the path so the next wanderer,
            often future-me, can skip the detours.
          </p>
        </div>
      </div>
      <div class="footer">
        <div class="nav-links">
          <a href="/portfolio/blog">Blog</a>
          <a href="/portfolio/projects">Projects</a>
          <a href="/portfolio/about">About me</a>
        </div>
        <div class="personal-links">
          <a
            class="icon-link"
            href="https://www.linkedin.com/in/aleksandar-d-gjoreski/"
            target="_blank"
          >
            <IconLinkedIn />
          </a>
          <a
            class="icon-link"
            href="https://github.com/alezen9"
            target="_blank"
          >
            <IconGitHub />
          </a>
          <a
            class="icon-link"
            href="https://x.com/aleksgjoreski"
            target="_blank"
          >
            <IconX />
          </a>
        </div>
        <p class="disclaimer">
          Personal hobby showcase, no commercial use.<br />
          If you own any referenced IP and want an asset removed, email me at
          <a href="mailto:aleksandar.d.gjoreski@gmail.com"
            >aleksandar.d.gjoreski@gmail.com</a
          >
          and I'll take action immediately.
        </p>
      </div>
    </main>
  </body>
</html>
