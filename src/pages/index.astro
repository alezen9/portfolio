---
import IconLinkedIn from "@components/icons/IconLinkedIn.astro";
import IconGitHub from "@components/icons/IconGitHub.astro";
import IconX from "@components/icons/IconX.astro";
import WordSwap from "@components/ui/WordSwap.astro";
import MangaLayout from "src/layouts/MangaLayout.astro";
import CopyrightsDisclaimer from "@components/ui/CopyrightsDisclaimer.astro";
---

<style>
  html,
  body {
    overscroll-behavior: none;
  }

  .hero {
    position: fixed;
    box-sizing: border-box;
    height: 100dvh;
    padding: 5em 0 2em 2em;
    max-width: min(750px, 100dvw);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(
      to right,
      var(--background-color),
      75%,
      transparent
    );
  }

  .header {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 2em;
  }

  .tagline {
    margin-bottom: 0.1em;
  }

  .signature {
    width: fit-content;
    font-size: 0.85em;
    font-weight: 300;
  }

  .typewriter {
    /* --chars: 46;
    --real-steps: calc(var(--chars) * 3); */
    position: relative;
    border-right: 1ch solid var(--text-color);
    white-space: nowrap;
    overflow: hidden;
    animation:
      typewriterProgression 1.5s 1s 1 normal both,
      blinkingCursor 0.75s infinite normal;
    animation-timing-function: linear; /* or use steps(var(--real-steps)) and tweak multiplier */
  }

  .intro {
    margin-top: 2em;
    display: grid;
    grid-template-columns: 1fr;
    font-weight: 200;
    font-size: 0.75em;
  }

  .nav-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5em;
  }

  .personal-links {
    display: flex;
    gap: 1em;
    align-items: center;
  }

  .icon-github {
    width: 1.75em;
  }

  .icon-x {
    width: 1.25em;
  }
  @keyframes typewriterProgression {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }
  @keyframes blinkingCursor {
    from {
      border-right-color: var(--text-color);
    }
    to {
      border-right-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter {
      animation: none;
      border: none;
    }
  }

  @media screen and (max-width: 480px) {
    .hero {
      padding: 4em 1.5em;
    }

    .tagline {
      font-size: 2.25em;
    }

    .typewriter {
      font-size: 0.85em;
    }
  }
</style>

<MangaLayout
  title="AG | Home "
  description="Creative front-end engineer exploring fast web apps, WebGL/WebGPU experiments and polished user experiences."
>
  <main class="hero">
    <div class="header">
      <h1 class="tagline">Pixels set in motion</h1>
      <div class="signature">
        <p class="typewriter">
          Aleksandar Gjoreski | Creative Frontend Engineer
        </p>
      </div>
      <div class="intro">
        <p>
          Pixels keep me busy, <WordSwap /> one day, plain CSS the next and sometimes
          just trimming a React bundle.
        </p>
        <p>
          I go after quick loads and steady frames, polishing the details no one
          notices...until they do.
        </p>
        <p>
          When something clicks, I write down the path so the next wanderer,
          often future-me, can skip the detours.
        </p>
      </div>
    </div>
    <div class="footer">
      <div class="nav-links">
        <!-- <a href="/portfolio/blog" aria-disabled="true">Blog</a> -->
        <a href="/portfolio/projects">Projects</a>
        <a href="/portfolio/about-me">About me</a>
      </div>
      <div class="personal-links">
        <a
          class="icon-link"
          href="https://www.linkedin.com/in/aleksandar-d-gjoreski/"
          target="_blank"
        >
          <IconLinkedIn class:list={["animate"]} />
        </a>
        <a class="icon-link" href="https://github.com/alezen9" target="_blank">
          <IconGitHub class:list={["animate", "icon-github"]} />
        </a>
        <a class="icon-link" href="https://x.com/aleksgjoreski" target="_blank">
          <IconX class:list={["animate", "icon-x"]} />
        </a>
      </div>
      <CopyrightsDisclaimer />
    </div>
  </main>
</MangaLayout>
