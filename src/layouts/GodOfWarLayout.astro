---
import BaseHead from "../components/ui/BaseHead.astro";
import TrackPointerMovement from "@components/islands/trackPointerMovement";
import GoHome from "@components/islands/GoHome.astro";
---

<html lang="en">
  <head>
    <BaseHead
      title="AG | Personal Projects"
      description="..."
      imageSrc="/og-images/projects.jpg"
    >
      <link
        rel="preload"
        href="/fonts/Berserker-Regular.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
      <link
        rel="preload"
        href="/gradient-mask.webp"
        as="image"
        type="image/webp"
        crossorigin
      /></BaseHead
    >
    <style is:global>
      @font-face {
        font-family: "Berserker-Regular";
        src: url("/fonts/Berserker-Regular.woff2") format("woff2");
      }
      html {
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
      }

      .wrapper {
        --text-accent: rgb(146, 41, 41);
        box-sizing: border-box;
        width: 100dvw;
      }

      .tagline {
        display: grid;
        grid-template-rows: 1fr 1fr;
        row-gap: 0.5em;
        margin: 0 auto 1em auto;
        max-width: min(80ch, 90dvw);
        font-family: "Berserker-Regular";
      }

      .tagline span.right-aligned {
        text-align: right;
      }

      .mask {
        position: relative;
      }

      .mask::after {
        position: absolute;
        content: "D";
        color: var(--text-accent);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        -webkit-mask-image: url(/god-of-war-mask.svg);
        mask-image: url(/god-of-war-mask.svg);
        mask-repeat: no-repeat;
        mask-position: 15%;
        mask-size: contain;
        filter: brightness(1.5);
      }

      .gallery {
        padding: 0;
        margin: 0;
        list-style-type: none;
      }

      .gallery .slide {
        position: relative;
        height: 100vh;
        scroll-snap-align: start;
        /* scroll-snap-stop: always; */
        box-sizing: border-box;
        view-timeline: --slide;
      }

      .gallery .slide .content {
        width: 100%;
        height: 100%;
        box-sizing: border-box;
      }

      .intro {
        display: grid;
        place-content: center;
      }

      .background-old {
        --r: 1px;
        --r-multiplier: 350; /* Slightly larger for smoother transition */
        --outer-size: calc(var(--r) * var(--r-multiplier));
        --p-x: calc(var(--pointer-x, 0) * 1%);
        --p-y: calc(var(--pointer-y, 0) * 1%);

        box-sizing: border-box;
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: url(/god-of-war-mask.svg);
        background-repeat: no-repeat;
        background-position: 80% center;
        background-size: auto 150vh;
        opacity: 0.25;
        z-index: -1;
        border: 2.5px solid red;

        mask-image: radial-gradient(
          circle at var(--p-x) var(--p-y),
          black,
          transparent var(--outer-size)
        );

        --drop-shadow-opacity: 1;
        filter: contrast(1.02) brightness(0.99)
          drop-shadow(
            5px 5px 10px rgba(var(--text-raw), var(--drop-shadow-opacity))
          );
      }

      /** https://grainy-gradients.vercel.app/noise.svg */
      .background {
        --mask-size: 800px;
        box-sizing: border-box;
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: url(/god-of-war-mask.svg);
        background-repeat: no-repeat;
        background-position: 80% center;
        background-size: auto 150vh;
        opacity: 0.5;
        z-index: -1;
        font-family: "Berserker-Regular";

        --drop-shadow-opacity: 0.75;
        filter: contrast(1.02) brightness(0.99)
          drop-shadow(
            5px 5px 15px rgba(var(--text-raw), var(--drop-shadow-opacity))
          );

        display: flex;
        flex-direction: column;
        justify-content: end;
        align-items: center;
        padding: 2em;
        gap: 3em;
      }

      .background .tagline-two {
        max-width: 350px;
        width: 100%;
        display: flex;
        flex-direction: column;
        font-size: 1.15em;
      }

      .background .tagline-two span:last-of-type {
        text-align: right;
      }

      .background span.algiz {
        position: relative;
        display: block;
        width: 0;
        height: 0.85lh;
        border: 1.5px solid;
        color: red;
      }

      .background span.algiz::before {
        position: absolute;
        top: -10%;
        left: -50%;
        width: 1ch;
        aspect-ratio: 1/1;
        content: "";
        border-top: 3px solid;
        border-right: 3px solid;
        transform: translate(-50%, -10%) rotate(135deg);
      }

      .background span.algiz::after {
        position: absolute;
        top: 50%;
        left: -50%;
        width: 1.5lh;
        aspect-ratio: 1/1;
        content: "";
        transform: translate(-50%, -50%);
        border: 3px double;
        border-radius: 50%;
        opacity: 0.25;
      }

      .background::before {
        position: absolute;
        inset: 0;
        pointer-events: none;
        content: "";
        border: 2.5px solid red;
      }

      @supports (animation-timeline: scroll()) {
        @keyframes fade {
          0%,
          100% {
            opacity: 0;
            scale: 0.9;
          }
          50% {
            opacity: 1;
            scale: 1;
          }
        }

        .gallery .slide .content {
          animation-name: fade;
          animation-timing-function: ease-in-out;
          animation-direction: both;
          animation-timeline: --slide;
        }
      }

      @media screen and (max-width: 480px) {
        .tagline {
          font-size: 1.8em;
        }

        .background {
          background-position: 20vw center;
        }
      }

      @media (pointer: coarse) {
        .background {
          --mask-size: 75%;
          --x: 50%;
          --y: 0%;
        }
      }

      @media (prefers-color-scheme: dark) {
        .background {
          --drop-shadow-opacity: 0;
        }
      }
    </style>
  </head>
  <body>
    <TrackPointerMovement client:only />
    <main class="wrapper">
      <GoHome />
      <ul class="gallery">
        <li class="slide">
          <div class="content intro">
            <div class="background gradient-mask" aria-hidden="true">
              <div class="tagline-two">
                <span>In which direction?</span>
                <span>In the direction of the deer.</span>
              </div>
              <span class="algiz"></span>
            </div>
            <h1 class="tagline">
              <span>What are we hunting?</span>
              <span class="right-aligned"
                ><span class="mask" aria-hidden="true">D</span>eer.</span
              >
            </h1>
          </div>
        </li>
        <slot />
      </ul>
    </main>
  </body>
</html>
