---
import IconLogo from "@components/icons/IconLogo.astro";
import BaseHead from "../components/ui/BaseHead.astro";
import ProjectsScrollAnimations from "@components/islands/projectsScrollAnimations";
import SetIsZoomed from "@components/islands/setIsZoomed";
import BlobMask from "@components/islands/BlobMask";
import TrackPointerMovement from "@components/islands/trackPointerMovement";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description}>
      <link
        rel="preload"
        href="/portfolio/fonts/Berserker-Regular.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      /></BaseHead
    >
    <style is:global>
      @font-face {
        font-family: "Berserker-Regular";
        src: url("/portfolio/fonts/Berserker-Regular.woff2") format("woff2");
      }
      html {
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
      }

      .is-zoomed {
        scroll-snap-type: none;
      }

      .wrapper {
        --text-accent: rgb(146, 41, 41);
        box-sizing: border-box;
        width: 100dvw;
      }

      .omega {
        height: 1ch;
        filter: brightness(0.85);
        transform: translateY(0.05em);
      }

      .tagline {
        display: grid;
        grid-template-rows: 1fr 1fr;
        row-gap: 0.5em;
        margin: 0 auto 1em auto;
        max-width: min(80ch, 90dvw);
        font-family: "Berserker-Regular";
      }

      .tagline span.right-aligned {
        text-align: right;
      }

      .mask {
        position: relative;
      }

      .mask::after {
        position: absolute;
        content: "D";
        color: var(--text-accent);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        -webkit-mask-image: url(/portfolio/god-of-war-mask.svg);
        mask-image: url(/portfolio/god-of-war-mask.svg);
        mask-repeat: no-repeat;
        mask-position: 15%;
        mask-size: contain;
        filter: brightness(1.5);
      }

      .gallery {
        padding: 0;
        margin: 0;
        list-style-type: none;
      }

      .gallery .slide {
        height: 100vh;
        scroll-snap-align: start;
        scroll-snap-stop: always;
        box-sizing: border-box;
        view-timeline: --slide;
      }

      .gallery .slide .content {
        overflow: hidden;
        position: fixed;
        inset: 0;
        background-color: var(--background-color);
      }

      .intro {
        display: grid;
        place-content: center;
      }

      .background {
        position: absolute;
        content: "";
        inset: 0;
        pointer-events: none;
        background: url(/portfolio/god-of-war-mask.svg);
        background-repeat: no-repeat;
        background-position: 80% center;
        background-size: auto 150vh;
        opacity: 0.15;
        z-index: -1;
      }

      .background::before {
        --px: calc(var(--pointer-x, 0) * 1%);
        --py: calc(var(--pointer-y, 0) * 1%);

        position: absolute;
        inset: 0;
        content: "";
        pointer-events: none;
        background: radial-gradient(
          circle at var(--px) var(--py),
          transparent 0%,
          var(--background-color) 50%
        );
      }

      .backwards-scroll-transition .slide .content {
        visibility: hidden;
        opacity: 0;
        will-change: visibility, translate, opacity;
      }

      .blink-scroll-transition .slide .content {
        --contrast: 2;
        --blur: 5px;
        visibility: hidden;
        filter: blur(var(--blur)) contrast(var(--contrast));
        opacity: 0;
        will-change: filter, visibility, opacity;
      }

      @supports (animation-timeline: scroll()) {
        @keyframes backwards-scroll {
          0% {
            translate: 0 -100%;
            visibility: hidden;
            opacity: 0;
            content-visibility: hidden;
          }

          50% {
            translate: 0;
            visibility: visible;
            opacity: 1;
            content-visibility: visible;
          }

          100% {
            translate: 0 100%;
            visibility: hidden;
            opacity: 0;
            content-visibility: hidden;
          }
        }
        .backwards-scroll-transition .slide .content {
          animation-name: backwards-scroll;
          animation-timing-function: ease-in-out;
          animation-direction: both;
          animation-timeline: --slide;
        }

        @keyframes blink {
          0,
          100% {
            filter: blur(--blur) contrast(--contrast);
            opacity: 1;
            visibility: visible;
            content-visibility: hidden;
          }
          50% {
            filter: blur(0) contrast(1);
            opacity: 1;
            visibility: visible;
            content-visibility: visible;
          }
        }

        .blink-scroll-transition .slide .content {
          animation-name: blink;
          animation-timing-function: ease-in-out;
          animation-direction: both;
          animation-timeline: --slide;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .gallery .slide .content {
          --contrast: 1;
          --blur: 0px;
          filter: none;
        }
      }

      @media screen and (max-width: 480px) {
        .tagline {
          font-size: 1.8em;
        }

        .background {
          background-position: 20vw center;
        }
      }

      @media (pointer: coarse) {
        .background::before {
          --px: 40%;
          --py: 40%;
        }
      }
    </style>
  </head>
  <body>
    <ProjectsScrollAnimations client:only />
    <SetIsZoomed client:only />
    <TrackPointerMovement client:only />
    <main class="wrapper">
      <!-- <a href="/portfolio" aria-label="Go back to Homepage">
        <IconLogo />
      </a> -->
      <ul class="gallery backwards-scroll-transition">
        <li class="slide">
          <div class="content intro">
            <div class="background" aria-hidden="true"></div>
            <h1 class="tagline">
              <span>What are we hunting?</span>
              <span class="right-aligned"
                ><span class="mask" aria-hidden="true">D</span>eer.</span
              >
            </h1>
          </div>
        </li>
        <slot />
      </ul>
    </main>
  </body>
</html>
