---
import trackPointerMovement from "src/scripts/trackPointerMovement";
import BaseHead from "../components/ui/BaseHead.astro";
import CopyrightsDisclaimer from "@components/ui/CopyrightsDisclaimer.astro";
import LightsaberExclamation from "@components/ui/LightsaberExclamation.astro";
import GoHome from "@components/islands/GoHome.astro";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description}>
      <link
        rel="preload"
        href="/fonts/Starjedi.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
      <link
        rel="preload"
        href="/gradient-mask.webp"
        as="image"
        type="image/webp"
        crossorigin
      />
    </BaseHead>
    <script>
      import trackPointerMovement from "src/scripts/trackPointerMovement";
      const cleanup = trackPointerMovement({ targets: ["figure"] });
    </script>
    <style>
      @font-face {
        font-family: "Starjedi";
        src: url("/fonts/Starjedi.woff2") format("woff2");
      }
      .background {
        --mask-size: 2000px;
        position: fixed;
        inset: 0;
        color: var(--text-color);
        pointer-events: none;
        z-index: -1;
        opacity: 0.075;
      }

      .background svg {
        all: unset;
      }

      .wrapper {
        --text-accent: rgb(255, 232, 31);
        box-sizing: border-box;
        width: 100%;
        max-width: min(80ch, 90dvw);
        min-height: 100dvh;
        margin: 0 auto;
        padding: 2em;
        display: flex;
        flex-direction: column;
        gap: 4em;
      }

      .tagline {
        display: grid;
        grid-template-rows: 1fr 1fr;
        margin-bottom: 1em;
        font-family: "Starjedi";
        color: var(--text-accent);
        filter: saturate(0.75) drop-shadow(0 0 10px rgba(0, 0, 0, 0.15))
          grayscale(0.15);
      }

      .tagline span.right-aligned {
        text-align: right;
      }

      @media (prefers-reduced-motion: reduce) {
        .background {
          display: none;
        }
      }

      @media (pointer: coarse) {
        .background {
          display: none;
        }
      }

      @media screen and (max-width: 720px) {
        .tagline {
          font-size: 2.2em;
        }
      }

      @media screen and (max-width: 480px) {
        .wrapper {
          padding: 2em;
          max-width: 100dvw;
        }
        .tagline {
          font-size: 1.5em;
        }
      }
    </style>
  </head>

