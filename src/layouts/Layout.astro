---
import BlobMask2 from "@components/islands/BlobMask2";
import BaseHead from "../components/ui/BaseHead.astro";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .background {
        position: absolute;
        inset: 0;
        height: 100dvh;
        width: 100dvw;
        z-index: -999;
        overflow: hidden;
      }

      .reveal-layer {
        position: fixed;
        inset: 0;
        mask-image: url("#blob-mask");
        -webkit-mask-image: url("#blob-mask");
      }

      .reveal-layer::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-color: var(--text-color);
        mask-image: url("#panel-mask");
        -webkit-mask-image: url("#panel-mask");
        mask-repeat: repeat;
        -webkit-mask-repeat: repeat;
        mask-size: 75%;
        mask-position: center;
      }

      @media (prefers-color-scheme: dark) {
        .reveal-layer {
          opacity: 0.1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal-layer {
          display: none;
        }
      }

      @media (pointer: coarse) {
        .reveal-layer {
          display: none;
        }
      }
    </style>
  </head>

  <body>
    <div class="background">
      <svg
        width="100%"
        xmlns="http://www.w3.org/2000/svg"
        style="aspect-ratio: 2103/1818;"
      >
        <defs>
          <pattern
            id="Pattern"
            x="0"
            y="0"
            width="45%"
            height="45%"
            viewBox="0 0 2103 1818"
            fill="currentColor"
            stroke="none"
            stroke-width="4"
          >
            <g>
              <path d="M1377 17H726V402.67H1377V17Z"></path>
              <path d="M1377 430.999H726V629.951H1377V430.999Z"></path>
              <path d="M1377 892V659.568H909.113L874.818 892H1377Z"></path>
              <path d="M859.507 892L891.353 659.568H726V892H859.507Z"></path>
              <path d="M1866 17H1437V298.5H1866V17Z"></path>
              <path d="M1883 298.5V17H2087.5V298.5H1883Z"></path>
              <path d="M2087.5 891.5V314.5H1661.5V891.5H2087.5Z"></path>
              <path d="M1437 314.5H1645V594.5H1437V314.5Z"></path>
              <path d="M1437 610H1645V891.5H1437V610Z"></path>
              <path d="M15 892H666V319.172H15V892Z"></path>
              <path d="M666 17V291.364H15V17H666Z"></path>
            </g>
            <mask
              id="mask0_42_38"
              style="mask-type:alpha"
              maskUnits="userSpaceOnUse"
              x="0"
              y="909"
              width="2103"
              height="909"
            >
              <rect y="909" width="2103" height="909" fill="#D9D9D9"></rect>
            </mask>
            <g mask="url(#mask0_42_38)">
              <path d="M1763 926H1112V1311.67H1763V926Z"></path>
              <path d="M1763 1340H1112V1538.95H1763V1340Z"></path>
              <path d="M1763 1801V1568.57H1295.11L1260.82 1801H1763Z"></path>
              <path d="M1245.51 1801L1277.35 1568.57H1112V1801H1245.51Z"></path>
              <path d="M2252 926H1823V1207.5H2252V926Z"></path>
              <path d="M2269 1207.5V926H2473.5V1207.5H2269Z"></path>
              <path d="M2473.5 1800.5V1223.5H2047.5V1800.5H2473.5Z"></path>
              <path d="M1823 1223.5H2031V1503.5H1823V1223.5Z"></path>
              <path d="M1823 1519H2031V1800.5H1823V1519Z"></path>
              <path d="M119 926H-310V1207.5H119V926Z"></path>
              <path d="M136 1207.5V926H340.5V1207.5H136Z"></path>
              <path d="M340.5 1800.5V1223.5H-85.5V1800.5H340.5Z"></path>
              <path d="M-310 1223.5H-102V1503.5H-310V1223.5Z"></path>
              <path d="M-310 1519H-102V1800.5H-310V1519Z"></path>
              <path d="M401 1801H1052V1228.17H401V1801Z"></path>
              <path d="M1052 926V1200.36H401V926H1052Z"></path>
            </g>
          </pattern>
        </defs>

        <mask id="panel-mask" maskUnits="objectBoundingBox">
          <rect fill="url(#Pattern)" width="100%" height="100%"></rect>
        </mask>
      </svg>
      <div class="reveal-layer" aria-hidden="true"></div>
      <BlobMask2 client:only />
    </div>
    <slot />
  </body>
</html>
