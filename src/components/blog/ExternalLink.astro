---
import IconYoutube from "@components/icons/IconYouTube.astro";
import IconArticle from "@components/icons/IconArticle.astro";
import IconX from "@components/icons/IconX.astro";

type Props = {
  icon?: "article" | "youtube" | "x";
};

const { icon, ...rest } = Astro.props;
---

<a {...rest} target="_blank" rel="noopener" class="external-link">
  {icon === "youtube" && <IconYoutube />}
  {icon === "article" && <IconArticle />}
  {icon === "x" && <IconX class="icon-x" />}
  <slot />
</a>

<style is:global>
  a.external-link {
    position: relative;
    display: inline-flex;
    gap: 0.5em;
  }

  a.external-link svg {
    width: 1.25em;
    height: 1.25em;
    aspect-ratio: 1/1;
    position: absolute;
    top: 0.15em;
    left: 0;
  }

  a.external-link p {
    margin: 0;
    padding-left: 1.75em;
  }

  a.external-link svg.icon-x {
    width: 0.85em;
    height: 0.85em;
    top: 0.35em;
    left: 0.25em;
  }
</style>
