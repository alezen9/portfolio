---
import IconYoutube from "@components/icons/IconYouTube.astro";
import IconArticle from "@components/icons/IconArticle.astro";

type Props = {
  icon?: "article" | "youtube";
};

const { icon, ...rest } = Astro.props;
---

<a {...rest} target="_blank" rel="noopener" class="external-link">
  {icon === "youtube" && <IconYoutube class:list={["icon-youtube"]} />}
  {icon === "article" && <IconArticle class:list={["icon-article"]} />}
  <slot />
</a>

<style is:global>
  a.external-link {
    position: relative;
    display: inline-flex;
    gap: 0.5em;
  }

  a.external-link svg {
    width: 1.25em;
    height: 1.25em;
    aspect-ratio: 1/1;
    position: absolute;
    top: 0.15em;
    left: 0;
  }

  a.external-link p {
    margin: 0;
    padding-left: 1.75em;
  }
</style>
