---
type Props = {
  xUrl?: string;
  linkedInUrl?: string;
};

const { xUrl, linkedInUrl } = Astro.props;
---

<footer>
  <a class="with-icon" href={xUrl} target="_blank">
    Discuss on X
    <!-- <IconX class:list={["icon-x"]} /> -->
  </a>
  <span>•</span>
  <a class="with-icon" href={linkedInUrl} target="_blank">
    Discuss on LinkedIn
    <!-- <IconLinkedIn class:list={["icon-linkedin"]} /> -->
  </a>
</footer>

<style>
  footer {
    margin-block: 5.5em 3.5em;
    display: flex;
    gap: 0.5em;
  }

  a {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    text-wrap: nowrap;
    gap: 0.5em;
  }

  span {
    opacity: 0.5;
  }

  svg {
    width: auto;
  }

  .icon-x {
    height: 0.75em;
  }
  .icon-linkedin {
    height: 1.25em;
  }
</style>
