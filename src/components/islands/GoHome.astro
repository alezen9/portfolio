---
import IconHome from "@components/icons/IconHome.astro";
import GoHomeVisibility from "./goHomeVisibility";
---

<style>
  a.go-home::before,
  a.go-home::after {
    display: none;
  }
  a.go-home.hide {
    display: none;
  }

  a.go-home.show {
    display: block;
  }

  a.go-home {
    display: none;
    position: fixed;
    top: 1em;
    right: 2em;
    padding: 1em;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    z-index: 1;
    backdrop-filter: blur(4px) contrast(1);
    color: color-mix(in oklab, var(--text-accent) 75%, var(--text-color));
    opacity: 0.25;
    scale: 1;
    transition:
      opacity 0.5s ease-in-out,
      scale 0.5s cubic-bezier(0.075, 0.82, 0.165, 1);
  }

  @media (pointer: fine) {
    a.go-home.show:hover {
      opacity: 1;
      scale: 1.1;
    }
  }

  @media (pointer: coarse) {
    a.go-home.show {
      opacity: 1;
      transition: none;
      top: 0.5em;
      right: 0.5em;
    }
  }

  /* a:hover svg path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: animateDash 0.5s ease-in-out forwards;
    animation-delay: calc(var(--i) * 0.25s);
  } */
</style>
<a class="go-home" href="/" aria-label="Go back to Homepage">
  <!-- <GoHomeVisibility client:only /> -->
  <IconHome />
</a>
