---
import IconMenu from "@components/icons/IconMenu.astro";
import IconMoon from "@components/icons/IconMoon.astro";
import IconVolume from "@components/icons/IconVolume.astro";
import IconHome from "@components/icons/IconHome.astro";
import IconSun from "@components/icons/IconSun.astro";

// Homepage
const currentUrl = Astro.url.toString().replace(/\/$/, "");
const urlBase = Astro.url.origin;
const isHomepage = currentUrl === urlBase;
const homepageLinkTitle = isHomepage
  ? "You are already home :)"
  : "Go to homepage";
const homepageLinkHref = isHomepage ? null : "/";
---

<style>
  nav {
    --btn-size: 2.25em;
    --svg-size: 1.25em;
    --pad: 0.25em;
    --tray-gap: 0.25em;
    --n-elements: 2; /** in tray, no menu button */
    --tray-size: calc(
      var(--btn-size) * var(--n-elements) + var(--tray-gap) *
        (var(--n-elements) - 1)
    );
    position: fixed;
    top: 2em;
    right: 2em;
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    border-radius: 999px;
    z-index: 10;
    padding: var(--pad);
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  nav * {
    color: color-mix(in oklab, var(--text-color) 75%, transparent);
  }

  nav::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;

    clip-path: inset(0 round 999px);
    -webkit-mask-image: radial-gradient(#000 98%, transparent 100%);

    /* background-color: color-mix(in oklab, var(--bg-color) 65%, transparent); */
    background-color: color-mix(
      in oklab,
      rgba(var(--bg-raw), 0.5) 95%,
      rgba(var(--text-raw), 0.75)
    );

    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);

    transform: translateZ(0);
    z-index: 0;
    pointer-events: none;
    box-shadow: 4px 4px 10px 2px rgba(var(--text-raw), 0.1);
  }

  summary,
  details::details-content {
    transform: translateZ(0);
  }

  details {
    display: contents;
  }

  summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    height: var(--btn-size);
    aspect-ratio: 1/1;
    z-index: 1;
    border-radius: 50%;
  }
  summary::-webkit-details-marker,
  summary::marker {
    display: none;
  }

  svg {
    width: var(--svg-size);
    aspect-ratio: 1/1;
    filter: contrast(10);
  }

  details::details-content {
    opacity: 0;
    width: 0;

    transition:
      opacity 0.25s ease,
      width 0.15s ease;
  }

  details[open]::details-content {
    opacity: 1;
    width: var(--tray-size);
  }

  ul {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tray-gap);
  }
  li {
    margin: 0;
    padding: 0;
    height: var(--btn-size);
    aspect-ratio: 1/1;
    position: relative;
    border-radius: 50%;
    transition: background-color 0.5s ease;
  }

  li:has(> *[aria-disabled="true"]) {
    pointer-events: none;
  }

  li:not([data-home="true"]):hover {
    background-color: color-mix(in oklab, var(--text-color) 10%, transparent);
  }

  li > * {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 50%;
    cursor: pointer;
  }

  input[type="checkbox"] {
    position: absolute;
    border-radius: 50%;
    inset: 2px;
    appearance: none;
    cursor: pointer;
  }

  .color-scheme {
    display: flex;
    flex-direction: column;
    gap: var(--svg-size);
    padding: 0.5em 0;
    transform: translateY(0);
  }

  .transition-color-scheme {
    transition: transform 0.5s cubic-bezier(0.4, -0.1, 0.55, 1.17);
  }

  :root[data-theme="dark"] .color-scheme {
    transform: translateY(calc(var(--svg-size) * -2));
  }

  @media screen and (max-width: 1200px) {
    nav {
      top: 1em;
      right: 1em;
    }
  }

  @media screen and (max-width: 770px) {
    nav {
      display: none;
    }
  }
</style>

<script>
  // Theme
  import { init } from "@utils/theme";
  const theme = init();
  document.documentElement.dataset.theme = theme.initialValue.colorScheme;
  theme.subscribe((p) => (document.documentElement.dataset.theme = p));

  (() => {
    const toggle = document.getElementById("theme-toggle") as HTMLInputElement;
    if (!toggle) return;
    toggle.checked = theme.initialValue.colorScheme === "dark";
    theme.subscribe((p) => (toggle.checked = p === "dark"));

    const icons = document.querySelector(".color-scheme");
    const cls = "transition-color-scheme";
    toggle.addEventListener("change", (e) => {
      if (!e.target) return;
      theme.toggle();
      if (!icons?.classList.contains(cls)) icons?.classList.add(cls);
    });
  })();
</script>

<nav aria-label="Site settings">
  <details open>
    <summary aria-label="Open settings" aria-controls="settings-tray">
      <IconMenu />
    </summary>

    <ul id="settings-tray">
      <li data-home={isHomepage}>
        <a id="homepage-link" title={homepageLinkTitle} href={homepageLinkHref}>
          <IconHome />
        </a>
      </li>
      <li>
        <label for="theme-toggle" title="Toggle appearance">
          <input id="theme-toggle" type="checkbox" name="theme" />
          <span class="color-scheme">
            <IconSun aria-label="Light mode" />
            <IconMoon aria-label="Dark mode" />
          </span>
        </label>
      </li>
      <!-- <span title="Toggle sound (coming soon)">
        <li inert>
          <label for="audio-toggle" aria-disabled="true">
            <input id="audio-toggle" type="checkbox" name="audio" />
            <IconVolume />
          </label>
        </li>
      </span> -->
    </ul>
  </details>
</nav>
