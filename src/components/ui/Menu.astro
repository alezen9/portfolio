---
import IconMenu from "@components/icons/IconMenu.astro";
import IconMoon from "@components/icons/IconMoon.astro";
import IconVolume from "@components/icons/IconVolume.astro";
import IconHome from "@components/icons/IconHome.astro";
import IconSun from "@components/icons/IconSun.astro";
---

<style>
  nav[aria-label="Site settings"] {
    --btn-size: 2.25em;
    --svg-size: 1.25em;
    --pad: 0.25em;
    --tray-gap: 0.25em;
    --n-elements: 3; /** in tray, no menu button */
    --tray-size: calc(var(--n-elements) * var(--btn-size) + var(--tray-gap));
    position: fixed;
    top: 2em;
    right: 2em;
    display: flex;
    align-items: center;
    color: color-mix(in oklab, var(--text-color) 75%, transparent);
    border-radius: 999px;
    z-index: 10;
    padding: var(--pad);
    overflow: hidden;
  }

  nav[aria-label="Site settings"]::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;

    clip-path: inset(0 round 999px);
    -webkit-mask-image: radial-gradient(#000 98%, transparent 100%);

    background: color-mix(in oklab, var(--bg-color, white) 65%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);

    transform: translateZ(0);
    z-index: 0;
    pointer-events: none;
    box-shadow: 4px 4px 10px 2px rgba(var(--text-raw), 0.1);
  }

  summary,
  details::details-content {
    transform: translateZ(0);
  }

  nav details {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
  }

  summary {
    list-style: none;
    -webkit-user-select: none;
    user-select: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    height: var(--btn-size);
    aspect-ratio: 1/1;
    z-index: 1;
    border-radius: 50%;
  }
  summary::-webkit-details-marker,
  summary::marker {
    display: none;
  }

  svg {
    width: var(--svg-size);
    aspect-ratio: 1/1;
    filter: contrast(10);
  }

  details::details-content {
    opacity: 0;
    width: 0;
    transition:
      opacity 0.5s ease,
      width 0.5s ease;
  }

  details[open]::details-content {
    opacity: 1;
    width: var(--tray-size);
  }

  ul {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tray-gap);
  }
  li {
    margin: 0;
    padding: 0;
    height: var(--btn-size);
    aspect-ratio: 1/1;
    position: relative;
    border-radius: 50%;
    transition: background-color 0.5s ease;
  }

  li:not(:has(label[aria-disabled="true"])):hover {
    background-color: color-mix(in oklab, var(--text-color) 10%, transparent);
  }

  li > * {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 50%;
    cursor: pointer;
  }

  input[type="checkbox"] {
    position: absolute;
    border-radius: 50%;
    inset: 0;
    appearance: none;
    cursor: pointer;
  }

  .color-scheme {
    display: flex;
    flex-direction: column;
    gap: var(--svg-size);
    padding: 0.5em 0;
    transform: translateY(0);
    transition: transform 0.5s cubic-bezier(0.4, -0.1, 0.55, 1.17);
  }

  @media (prefers-color-scheme: dark) {
    nav[aria-label="Site settings"]::before {
      background: rgba(var(--bg-raw), 0.5);
      /* box-shadow: none; */
    }

    .color-scheme {
      transform: translateY(calc(var(--svg-size) * -2));
    }
  }
</style>

<script>
  const isHomepage =
    document.location.href.replace(/\/$/, "") === document.location.origin;
  const homepageLink = document.getElementById(
    "homepage-link",
  ) as HTMLAnchorElement;
  if (!isHomepage && homepageLink) {
    homepageLink.title = "Go to homepage";
    homepageLink.href = "/";
  }

  const themeToggle = document.getElementById(
    "theme-toggle",
  ) as HTMLInputElement;
  if (themeToggle) {
    themeToggle.defaultChecked = true;
    document.documentElement.dataset.theme = "dark";
    const onToggle = (e: Event) => {
      if (!e.target) return;
      const theme = (e.target as HTMLInputElement).checked ? "dark" : "light";
      document.documentElement.dataset.theme = theme;
    };
    themeToggle.addEventListener("change", onToggle);
  }
</script>

<nav aria-label="Site settings">
  <details open>
    <summary aria-label="Open settings">
      <IconMenu />
    </summary>

    <ul>
      <li>
        <a id="homepage-link" title="You are already home :)">
          <IconHome />
        </a>
      </li>
      <li>
        <label for="theme-toggle" title="Toggle appearance">
          <input id="theme-toggle" type="checkbox" name="theme" />
          <span class="color-scheme">
            <IconSun aria-label="Light mode" />
            <IconMoon aria-label="Dark mode" />
          </span>
        </label>
      </li>
      <li>
        <label
          for="audio-toggle"
          title="Audio coming soon"
          aria-disabled="true"
        >
          <input id="audio-toggle" type="checkbox" name="audio" disabled />
          <IconVolume />
        </label>
      </li>
    </ul>
  </details>
</nav>
