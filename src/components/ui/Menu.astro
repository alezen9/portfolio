---
import IconMenu from "@components/icons/IconMenu.astro";
import IconColorScheme from "@components/icons/IconColorScheme.astro";
import IconAudio from "@components/icons/IconAudio.astro";
---

<style>
  nav[aria-label="Site settings"] {
    --btn-size: 2.25em;
    --pad: 0.25em;
    --tray-gap: 0.25em;
    --n-elements: 2; /** in tray, no menu button */
    --tray-size: calc(var(--n-elements) * var(--btn-size) + var(--tray-gap));
    position: fixed;
    top: 2em;
    right: 2em;
    display: flex;
    align-items: center;
    color: color-mix(in oklab, var(--text-color) 75%, transparent);
    border-radius: 999px;
    z-index: 10;
    padding: var(--pad);
    overflow: hidden;
  }

  nav[aria-label="Site settings"]::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;

    clip-path: inset(0 round 999px);
    -webkit-mask-image: radial-gradient(#000 98%, transparent 100%);

    background: color-mix(in oklab, var(--bg-color, white) 65%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);

    transform: translateZ(0);
    z-index: 0;
    pointer-events: none;
    box-shadow: 4px 4px 10px 2px rgba(var(--text-raw), 0.1);
  }

  summary,
  details::details-content {
    transform: translateZ(0);
  }

  nav details {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
  }

  summary {
    list-style: none;
    -webkit-user-select: none;
    user-select: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    height: var(--btn-size);
    aspect-ratio: 1/1;
    z-index: 1;
    border-radius: 50%;
  }
  summary::-webkit-details-marker,
  summary::marker {
    display: none;
  }

  svg {
    width: 1.25em;
    aspect-ratio: 1/1;
  }

  details::details-content {
    opacity: 0;
    width: 0;
    transition-property: opacity, width;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
  }

  details[open]::details-content {
    opacity: 1;
    width: var(--tray-size);
  }

  ul {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tray-gap);
  }
  li {
    margin: 0;
    padding: 0;
    height: var(--btn-size);
    aspect-ratio: 1/1;
    position: relative;
  }

  li label {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 50%;
    cursor: pointer;
  }
  /* li svg {
    height: 1em;
    aspect-ratio: 1/1;
  } */

  input[type="checkbox"] {
    position: absolute;
    border-radius: 50%;
    inset: 0;
    appearance: none;
    cursor: pointer;
  }

  li input:checked + svg {
    /* do later */
    color: red;
  }

  @media (prefers-color-scheme: dark) {
    nav[aria-label="Site settings"]::before {
      background: rgba(var(--bg-raw), 0.5);
      /* box-shadow: none; */
    }
  }
</style>

