<style>
  svg {
    height: 1em;
    transform: translate(-0.15em, 0.015em);
  }

  .saber path {
    transform-origin: center 70%;
    transform: scaleY(0);
    will-change: transform;
    animation: ignite 0.75s ease-in-out forwards 1.5s;
  }

  .dot {
    transform-origin: center 97.5%;
    transform: scale(0.9);
  }

  .dot-gradient {
    background: conic-gradient(
      from 90deg,
      rgba(139, 139, 139, 1) 0deg,
      rgba(217, 217, 217, 1) 45deg,
      rgba(115, 115, 115, 1) 169.615deg,
      rgba(217, 217, 217, 1) 226.731deg,
      rgba(115, 115, 115, 1) 346.154deg,
      rgba(139, 139, 139, 1) 360deg
    );
    opacity: 1;
    width: 100%;
  }

  @keyframes ignite {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .saber path {
      animation: none;
      transform: scaleY(0.85);
    }
  }
</style>

