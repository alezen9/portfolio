<style>
  .word-swap {
    position: relative;
    --r: 20px;
    --time: 10s;
    perspective: 800px;
    display: inline-block;
    width: 6ch;
    height: 1lh;
    overflow: hidden;
    vertical-align: middle;
  }

  .face {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    transform-origin: 50% 50% calc(-1 * var(--r));
    backface-visibility: hidden;
  }

  .face.webgl {
    transform: rotateX(0);
  }

  .face.webgpu {
    transform: rotateX(-180deg);
  }

  .rotor {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform-origin: 50% 50% calc(-1 * var(--r));
    animation: spin ease-in-out infinite;
    animation-duration: var(--time);
  }
  @keyframes spin {
    5% {
      transform: rotateX(0deg);
    }
    50% {
      transform: rotateX(0deg);
    }
    55% {
      transform: rotateX(-180deg);
    }
    95% {
      transform: rotateX(-180deg);
    }
    100% {
      transform: rotateX(-360deg);
    }
  }
</style>

<span class="word-swap">
  <span class="rotor">
    <span class="face webgl">WebGL</span>
    <span class="face webgpu">WebGPU</span>
  </span>
</span>
