<style>
  .word-swap {
    position: relative;
    --r: 15px;
    --time: 15s;
    perspective: 800px;
    display: inline-block;
    width: 6ch;
    height: 1lh;
    transform: translateY(0.25lh);
    overflow: hidden;
  }

  .face {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    transform-origin: 50% 50% calc(-1 * var(--r));
    backface-visibility: hidden;
  }

  .face.webgpu {
    transform: rotateX(0);
  }

  .face.webgl {
    transform: rotateX(-180deg);
  }

  .rotor {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform-origin: 50% 50% calc(-1 * var(--r));
    animation: spin ease-in-out infinite;
    animation-duration: var(--time);
  }

  /* @keyframes spin {
    0%,
    10% {
      transform: rotateX(0deg);
    }

    15%,
    35% {
      transform: rotateX(-90deg);
    }

    40%,
    60% {
      transform: rotateX(-180deg);
    }

    65%,
    85% {
      transform: rotateX(-270deg);
    }

    90%,
    100% {
      transform: rotateX(-360deg);
    }
  } */

  @keyframes spin {
    0%,
    49% {
      transform: rotateX(0deg);
    }
    51%,
    98% {
      transform: rotateX(-180deg);
    }
    100% {
      transform: rotateX(-360deg);
    }
  }
</style>

<span class="word-swap">
  <span class="rotor">
    <span class="face webgpu">WebGPU</span>
    <span class="face webgl">WebGL</span>
  </span>
</span>
